---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../data/site';
import { contact } from '../data/contact';
import { withBase } from '../utils/paths';
import {
  absoluteUrl,
  alternateLocales,
  hreflangLinks,
  localeMeta,
  pagePathname,
  useI18n,
} from '../i18n';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  index?: boolean;
}

const { title, description, ogImage = site.ogImage, index = true } = Astro.props;
const { locale, pageKey, t, copy } = useI18n(Astro);
const meta = localeMeta[locale];
const canonicalURL = absoluteUrl(pagePathname(pageKey, locale));
const ogImagePath = ogImage.startsWith('http') ? ogImage : withBase(ogImage);
const ogImageUrl = ogImagePath.startsWith('http')
  ? ogImagePath
  : new URL(ogImagePath, Astro.site ?? new URL(site.url)).href;
const fontHref =
  'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Source+Sans+3:wght@400;500;600&display=swap';
const tagline = (copy.common as { tagline: string }).tagline;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: site.name,
  description: tagline,
  url: canonicalURL,
  inLanguage: meta.bcp47,
  image: ogImageUrl,
  email: contact.email,
  telephone: contact.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address,
    addressLocality: 'Villamanrique',
    addressRegion: 'Ciudad Real',
    postalCode: '13343',
    addressCountry: 'ES',
  },
  sameAs: [contact.facebook, contact.instagram],
};

const alternates = hreflangLinks(pageKey);
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={index ? 'index, follow' : 'noindex, follow'} />
    <meta name="theme-color" content="#4a6741" />
    <meta name="author" content={site.name} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase('/favicon-192.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="shortcut icon" href={withBase('/favicon-32.png')} />
    {index && <link rel="canonical" href={canonicalURL} />}
    {
      index &&
        alternates.map((link) => (
          <link rel="alternate" hreflang={link.lang} href={link.url} />
        ))
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      alternateLocales(locale).map((item) => (
        <meta property="og:locale:alternate" content={localeMeta[item].ogLocale} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t('common.skipLink')}</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
