---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ConversionChrome from '../components/conversion/ConversionChrome.astro';
import CloudflareAnalytics from '../components/analytics/CloudflareAnalytics.astro';
import DeferredVideoScript from '../components/ui/DeferredVideoScript.astro';
import { site } from '../data/site';
import { withBase } from '../utils/paths';
import { jsonLdGraph } from '../data/schema';
import { getImageVariant, srcset } from '../data/media';
import {
  absoluteUrl,
  alternateLocales,
  hreflangLinks,
  legalPageKeys,
  localeMeta,
  pagePathname,
  useI18n,
  type LegalPageKey,
} from '../i18n';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  index?: boolean;
  lcpSrc?: string;
}

const { title, description, ogImage = site.ogImage, index = true, lcpSrc } = Astro.props;
const lcpVariant = lcpSrc ? getImageVariant(lcpSrc) : null;
const { locale, pageKey, t } = useI18n(Astro);
const meta = localeMeta[locale];
const canonicalURL = absoluteUrl(pagePathname(pageKey, locale));
const ogImagePath = ogImage.startsWith('http') ? ogImage : withBase(ogImage);
const ogImageUrl = ogImagePath.startsWith('http')
  ? ogImagePath
  : new URL(ogImagePath, Astro.site ?? new URL(site.url)).href;
const structuredGraph = jsonLdGraph(locale, pageKey, canonicalURL, pageKey === 'home');
const overlayHeader = !legalPageKeys.includes(pageKey as LegalPageKey);

const alternates = hreflangLinks(pageKey);
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      lcpVariant && (
        <>
          <link
            rel="preload"
            as="image"
            type="image/avif"
            imagesrcset={srcset(lcpVariant.avif)}
            imagesizes="100vw"
            fetchpriority="high"
          />
        </>
      )
    }
    <meta name="description" content={description} />
    <meta name="robots" content={index ? 'index, follow' : 'noindex, follow'} />
    <meta name="theme-color" content="#2f3f2a" />
    <meta name="author" content={site.name} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase('/favicon-192.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="shortcut icon" href={withBase('/favicon-32.png')} />
    {index && <link rel="canonical" href={canonicalURL} />}
    {
      index &&
        alternates.map((link) => (
          <link rel="alternate" hreflang={link.lang} href={link.url} />
        ))
    }
    <link
      rel="preload"
      href={withBase('/fonts/source-sans-3-latin-400-normal.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      pageKey !== 'la-calerilla' && (
        <link
          rel="preload"
          href={withBase('/fonts/source-sans-3-latin-500-normal.woff2')}
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    <link
      rel="preload"
      href={withBase('/fonts/playfair-display-latin-400-normal.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      pageKey !== 'la-calerilla' && (
        <link
          rel="preload"
          href={withBase('/fonts/playfair-display-latin-500-normal.woff2')}
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      alternateLocales(locale).map((item) => (
        <meta property="og:locale:alternate" content={localeMeta[item].ogLocale} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <slot name="head" />
    {
      structuredGraph.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    <title>{title}</title>
  </head>
  <body class:list={[{ 'has-hero': overlayHeader }]}>
    <a class="skip-link" href="#main-content">{t('common.skipLink')}</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ConversionChrome />
    <CloudflareAnalytics locale={locale} pageKey={pageKey} />
    <DeferredVideoScript />
  </body>
</html>
