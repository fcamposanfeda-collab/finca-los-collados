---
import { contact } from '../../data/contact';
import { bookingComPropertyUrl, buildPageWhatsAppUrl } from '../../data/booking';
import { isHuntingPage } from '../../data/hunting';
import { useI18n } from '../../i18n';

const { locale, pageKey, href, copy } = useI18n(Astro);
const conv = copy.conversion as {
  fabAria: string;
  barAria: string;
  barHuntingAria: string;
  barReserve: string;
  barDossier: string;
  barWhatsapp: string;
  barCall: string;
};
const huntingPage = isHuntingPage(pageKey);
const whatsappUrl = buildPageWhatsAppUrl(pageKey, locale);
const bookingUrl = bookingComPropertyUrl(locale);
const reserveHref = huntingPage
  ? '#solicitud-caza'
  : pageKey === 'alojamiento' || pageKey === 'packs' || pageKey === 'home' || pageKey === 'reservas-online'
    ? bookingUrl
    : href('contacto') + '?motivo=' + (
        pageKey === 'eventos' ? 'eventos'
          : pageKey === 'empresas' ? 'empresas'
            : pageKey === 'la-finca' ? 'finca-completa'
              : 'general'
      );
const reserveExternal = reserveHref.startsWith('http');
const barAria = huntingPage ? conv.barHuntingAria : conv.barAria;
const barPrimaryLabel = huntingPage ? conv.barDossier : conv.barReserve;
---

<a
  class="wa-fab"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-track="whatsapp"
  data-track-source="fab"
  aria-label={conv.fabAria}
>
  <svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28">
    <path
      fill="currentColor"
      d="M17.47 14.38c-.28-.14-1.64-.81-1.9-.9-.25-.1-.44-.14-.62.14-.18.27-.71.9-.87 1.08-.16.18-.32.2-.6.07-.28-.14-1.17-.43-2.23-1.38-.82-.73-1.38-1.64-1.54-1.91-.16-.28-.02-.42.12-.56.13-.13.28-.32.42-.48.14-.16.18-.27.28-.45.09-.18.05-.34-.02-.48-.07-.14-.62-1.49-.85-2.04-.22-.53-.45-.46-.62-.47h-.53c-.18 0-.48.07-.73.34-.25.27-.96.94-.96 2.3s.98 2.67 1.12 2.85c.14.18 1.93 2.95 4.67 4.14.65.28 1.16.45 1.56.57.65.21 1.25.18 1.72.11.53-.08 1.64-.67 1.87-1.32.23-.65.23-1.2.16-1.32-.07-.11-.25-.18-.53-.32zM12.04 21.8h-.01a9.8 9.8 0 0 1-4.99-1.37l-.36-.21-3.71.97 1-3.62-.23-.37a9.8 9.8 0 1 1 8.3 4.6zm8.36-17.8A11.76 11.76 0 0 0 12.03 0C5.44 0 .08 5.36.08 11.96c0 2.11.55 4.16 1.6 5.97L0 24l6.22-1.63a11.9 11.9 0 0 0 5.8 1.48h.01c6.59 0 11.95-5.36 11.95-11.96 0-3.2-1.24-6.2-3.58-8.46z"
    />
  </svg>
</a>

<nav class="reserve-bar" aria-label={barAria}>
  <a
    href={reserveHref}
    class="reserve-bar__btn"
    data-track={huntingPage ? 'dossier' : reserveExternal ? 'booking' : 'form'}
    data-track-source="bar"
    target={reserveExternal ? '_blank' : undefined}
    rel={reserveExternal ? 'noopener noreferrer' : undefined}
  >
    {barPrimaryLabel}
  </a>
  <a
    href={whatsappUrl}
    class="reserve-bar__btn"
    data-track="whatsapp"
    data-track-source="bar"
    target="_blank"
    rel="noopener noreferrer"
  >
    {conv.barWhatsapp}
  </a>
  <a href={`tel:${contact.phone}`} class="reserve-bar__btn" data-track="phone" data-track-source="bar">
    {conv.barCall}
  </a>
</nav>

<style>
  .wa-fab {
    display: none;
  }

  .reserve-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 70;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-primary);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .reserve-bar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.5rem 0.35rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-on-primary);
    background: var(--color-primary);
  }

  .reserve-bar__btn:hover,
  .reserve-bar__btn:focus-visible {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  :global(body) {
    padding-bottom: calc(3.25rem + env(safe-area-inset-bottom, 0px));
  }

  :global(body.nav-open) .reserve-bar {
    display: none;
  }

  @media (min-width: 768px) {
    .wa-fab {
      position: fixed;
      right: 1rem;
      bottom: 1.25rem;
      z-index: 80;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 3.25rem;
      height: 3.25rem;
      border-radius: 50%;
      color: #fff;
      background: #128c7e;
      box-shadow: none;
    }

    .wa-fab:hover {
      background: #075e54;
    }

    .reserve-bar {
      display: none;
    }

    :global(body) {
      padding-bottom: 0;
    }

    :global(body.nav-open) .wa-fab {
      display: none;
    }
  }
</style>
