---
import { bookingComPropertyUrl } from '../../data/booking';
import { useI18n } from '../../i18n';

interface Props {
  variant?: 'stay' | 'hunting';
  showHunting?: boolean;
}

const { variant = 'stay', showHunting = false } = Astro.props;
const huntingBlock = variant === 'hunting' || showHunting;
const { locale, href, copy } = useI18n(Astro);
const trust = copy.conversion.trust as {
  title: string;
  ratingTitle: string;
  rating: string;
  ratingLink: string;
  includesTitle: string;
  includes: string[];
  cancelTitle: string;
  cancelText: string;
  cancelLink: string;
  huntingTitle: string;
  huntingText: string;
  huntingBlockTitle: string;
  huntingItems: string[];
};
const bookingUrl = bookingComPropertyUrl(locale);
---

<section class="trust-block section" aria-labelledby="trust-block-title">
  <div class="container">
    {
      huntingBlock ? (
        <>
          <h2 id="trust-block-title" class="section__title">
            {trust.huntingBlockTitle}
          </h2>
          <ul class="trust-block__hunting">
            {trust.huntingItems.map((item, index) =>
              index === 2 ? (
                <li>
                  <a
                    href={bookingUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track="booking"
                    data-track-source="trust-hunting"
                  >
                    {item}
                  </a>
                </li>
              ) : (
                <li>{item}</li>
              ),
            )}
          </ul>
        </>
      ) : (
        <>
          <h2 id="trust-block-title" class="section__title">
            {trust.title}
          </h2>
          <div class="trust-block__grid">
            <article class="trust-block__card">
              <h3>{trust.ratingTitle}</h3>
              <p>{trust.rating}</p>
              <a
                href={bookingUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-track="booking"
                data-track-source="trust"
              >
                {trust.ratingLink}
              </a>
            </article>
            <article class="trust-block__card">
              <h3>{trust.includesTitle}</h3>
              <ul>
                {trust.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
            <article class="trust-block__card">
              <h3>{trust.cancelTitle}</h3>
              <p>{trust.cancelText}</p>
              <a href={href('politica-de-reservas')}>{trust.cancelLink}</a>
            </article>
          </div>
        </>
      )
    }
  </div>
</section>

<style>
  .trust-block__grid {
    display: grid;
    gap: 1.25rem;
  }

  .trust-block__card {
    padding: 1.5rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .trust-block__card h3 {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .trust-block__card p,
  .trust-block__card li {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .trust-block__card ul {
    display: grid;
    gap: 0.35rem;
  }

  .trust-block__card a,
  .trust-block__hunting a {
    display: inline-block;
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
  }

  .trust-block__card a {
    margin-top: 0.75rem;
  }

  .trust-block__hunting {
    display: grid;
    gap: 0.85rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust-block__hunting li {
    margin: 0;
    color: var(--color-muted);
    font-size: 1.05rem;
    letter-spacing: 0.01em;
  }

  @media (min-width: 768px) {
    .trust-block__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .trust-block__hunting {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
