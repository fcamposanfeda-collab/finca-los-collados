---
import OptimizedImage from './OptimizedImage.astro';

interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  compact?: boolean;
  imageSrc?: string;
  imageAlt?: string;
  ctaLabel?: string;
  ctaHref?: string;
  ctaTrack?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  secondaryTrack?: string;
}

const {
  title,
  subtitle,
  eyebrow,
  compact = false,
  imageSrc,
  imageAlt = '',
  ctaLabel,
  ctaHref,
  ctaTrack,
  secondaryLabel,
  secondaryHref,
  secondaryTrack,
} = Astro.props;

function isHttp(url?: string) {
  return Boolean(url && url.startsWith('http'));
}
---

<section
  class:list={['page-hero', { 'page-hero--compact': compact, 'page-hero--photo': Boolean(imageSrc) }]}
  aria-labelledby="page-hero-title"
>
  {
    imageSrc && (
      <OptimizedImage
        class="page-hero__img"
        src={imageSrc}
        alt={imageAlt}
        width={1600}
        height={900}
        loading="eager"
        fetchpriority="high"
        sizes="100vw"
      />
    )
  }
  <div class="page-hero__overlay"></div>
  <div class="container page-hero__content">
    {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
    <h1 id="page-hero-title" class="page-hero__title">{title}</h1>
    {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
    {
      (ctaHref && ctaLabel) || (secondaryHref && secondaryLabel) ? (
        <div class="page-hero__actions">
          {ctaHref && ctaLabel && (
            <a
              href={ctaHref}
              class="btn"
              data-track={ctaTrack}
              data-track-source="hero"
              target={isHttp(ctaHref) ? '_blank' : undefined}
              rel={isHttp(ctaHref) ? 'noopener noreferrer' : undefined}
            >
              {ctaLabel}
            </a>
          )}
          {secondaryHref && secondaryLabel && (
            <a
              href={secondaryHref}
              class="btn btn--outline"
              data-track={secondaryTrack}
              data-track-source="hero"
              target={isHttp(secondaryHref) ? '_blank' : undefined}
              rel={isHttp(secondaryHref) ? 'noopener noreferrer' : undefined}
            >
              {secondaryLabel}
            </a>
          )}
        </div>
      ) : null
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    margin-top: calc(-1 * var(--header-height));
    min-height: 28rem;
    height: 100svh;
    max-height: 40rem;
    background: var(--color-footer-bg);
    color: var(--color-on-dark);
  }

  .page-hero--compact {
    align-items: center;
    min-height: 18rem;
    height: auto;
    max-height: 28rem;
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      var(--color-hero-veil-strong) 0%,
      var(--color-hero-veil) 42%,
      rgb(28 25 20 / 0.28) 100%
    );
  }

  .page-hero__content {
    position: relative;
    z-index: 2;
    max-width: var(--container-text);
    padding-block: 3.5rem 3.25rem;
    padding-top: calc(var(--header-height) + 2.5rem);
    padding-bottom: calc(1.5rem + 3.25rem + env(safe-area-inset-bottom, 0px));
  }

  .page-hero__eyebrow {
    margin: 0 0 0.85rem;
    font-family: var(--font-primary);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: var(--letter-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .page-hero__title {
    margin: 0 0 0.85rem;
    font-weight: 400;
    font-size: clamp(1.85rem, 5vw, 3.35rem);
    color: var(--color-on-dark);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .page-hero__subtitle {
    margin: 0;
    max-width: 36rem;
    font-size: clamp(1.0625rem, 2vw, 1.2rem);
    color: rgb(244 239 230 / 0.88);
    line-height: 1.6;
    white-space: pre-line;
  }

  .page-hero--photo {
    overflow: hidden;
    background: var(--color-secondary);
  }

  .page-hero :global(picture.page-hero__img),
  .page-hero :global(img.page-hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .page-hero :global(.page-hero__img img),
  .page-hero :global(img.page-hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    max-width: none;
    opacity: 1;
  }

  @media (min-width: 768px) {
    .page-hero__content {
      padding-bottom: 3.5rem;
    }
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .page-hero__actions .btn {
    width: auto;
    min-width: min-content;
    white-space: nowrap;
    padding-inline: 1.2rem;
  }

  .page-hero__actions .btn--outline {
    color: var(--color-on-primary);
    border-color: var(--color-on-primary);
  }

  .page-hero__actions .btn--outline:hover {
    color: var(--color-text);
    background: var(--color-on-primary);
    border-color: var(--color-on-primary);
  }
</style>
