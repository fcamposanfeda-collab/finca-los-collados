---
import OptimizedImage from './OptimizedImage.astro';

interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  compact?: boolean;
  imageSrc?: string;
  imageAlt?: string;
  ctaLabel?: string;
  ctaHref?: string;
  ctaTrack?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  secondaryTrack?: string;
}

const {
  title,
  subtitle,
  eyebrow,
  compact = false,
  imageSrc,
  imageAlt = '',
  ctaLabel,
  ctaHref,
  ctaTrack,
  secondaryLabel,
  secondaryHref,
  secondaryTrack,
} = Astro.props;

function isHttp(url?: string) {
  return Boolean(url && url.startsWith('http'));
}
---

<section
  class:list={['page-hero', { 'page-hero--compact': compact, 'page-hero--photo': Boolean(imageSrc) }]}
  aria-labelledby="page-hero-title"
>
  {
    imageSrc && (
      <OptimizedImage
        class="page-hero__img"
        src={imageSrc}
        alt={imageAlt}
        width={1600}
        height={900}
        loading="eager"
        fetchpriority="high"
        sizes="100vw"
      />
    )
  }
  <div class="page-hero__overlay"></div>
  <div class="container page-hero__content">
    {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
    <h1 id="page-hero-title" class="page-hero__title">{title}</h1>
    {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
    {
      (ctaHref && ctaLabel) || (secondaryHref && secondaryLabel) ? (
        <div class="page-hero__actions">
          {ctaHref && ctaLabel && (
            <a
              href={ctaHref}
              class="btn"
              data-track={ctaTrack}
              data-track-source="hero"
              target={isHttp(ctaHref) ? '_blank' : undefined}
              rel={isHttp(ctaHref) ? 'noopener noreferrer' : undefined}
            >
              {ctaLabel}
            </a>
          )}
          {secondaryHref && secondaryLabel && (
            <a
              href={secondaryHref}
              class="btn btn--outline"
              data-track={secondaryTrack}
              data-track-source="hero"
              target={isHttp(secondaryHref) ? '_blank' : undefined}
              rel={isHttp(secondaryHref) ? 'noopener noreferrer' : undefined}
            >
              {secondaryLabel}
            </a>
          )}
        </div>
      ) : null
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(16rem, 40vh, 22rem);
    background:
      linear-gradient(135deg, rgba(44, 36, 25, 0.82), rgba(74, 103, 65, 0.72)),
      radial-gradient(ellipse at 80% 20%, rgba(201, 169, 110, 0.2), transparent 55%),
      var(--color-secondary);
    color: var(--color-on-primary);
  }

  .page-hero--compact {
    min-height: clamp(14rem, 32vh, 18rem);
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(135deg, rgba(44, 36, 25, 0.82), rgba(74, 103, 65, 0.72)),
      linear-gradient(to top, rgba(44, 36, 25, 0.35), transparent 65%);
  }

  .page-hero__content {
    position: relative;
    z-index: 2;
    max-width: 48rem;
    padding-block: 3rem;
  }

  .page-hero__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .page-hero__title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    color: var(--color-on-primary);
    line-height: 1.15;
  }

  .page-hero__subtitle {
    margin: 0;
    max-width: 40rem;
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
    white-space: pre-line;
  }

  .page-hero--photo {
    overflow: hidden;
    background: var(--color-secondary);
  }

  .page-hero :global(picture.page-hero__img),
  .page-hero :global(img.page-hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .page-hero :global(.page-hero__img img),
  .page-hero :global(img.page-hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    max-width: none;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .page-hero__actions .btn {
    width: auto;
    min-width: min-content;
    white-space: nowrap;
    padding-inline: 1.2rem;
  }

  .page-hero__actions .btn--outline {
    color: var(--color-on-primary);
    border-color: var(--color-on-primary);
  }

  .page-hero__actions .btn--outline:hover {
    color: var(--color-text);
    background: var(--color-on-primary);
    border-color: var(--color-on-primary);
  }
</style>
