---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import CtaBanner from './CtaBanner.astro';
import FullWidthVideo from './FullWidthVideo.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import FaqSection from '../seo/FaqSection.astro';
import RelatedPages from '../seo/RelatedPages.astro';

interface Props {
  title: string;
  description: string;
  heroTitle: string;
  heroSubtitle?: string;
  heroEyebrow?: string;
  heroImage?: string;
  heroImageAlt?: string;
  heroCtaLabel?: string;
  heroCtaHref?: string;
  heroCtaTrack?: string;
  heroSecondaryLabel?: string;
  heroSecondaryHref?: string;
  heroSecondaryTrack?: string;
  ctaTitle?: string;
  ctaText?: string;
  ctaButtonLabel?: string;
  ctaButtonHref?: string;
  ctaPrimaryTrack?: string;
  extraLabel?: string;
  extraHref?: string;
  extraTrack?: string;
  closingVideo?: string;
  closingVideoAlt?: string;
  closingVideoPosition?: string;
  index?: boolean;
}

const {
  title,
  description,
  heroTitle,
  heroSubtitle,
  heroEyebrow,
  heroImage,
  heroImageAlt,
  heroCtaLabel,
  heroCtaHref,
  heroCtaTrack,
  heroSecondaryLabel,
  heroSecondaryHref,
  heroSecondaryTrack,
  ctaTitle,
  ctaText,
  ctaButtonLabel,
  ctaButtonHref,
  ctaPrimaryTrack,
  extraLabel,
  extraHref,
  extraTrack,
  closingVideo,
  closingVideoAlt,
  closingVideoPosition,
  index = true,
} = Astro.props;
---

<BaseLayout title={title} description={description} index={index} lcpSrc={heroImage}>
  <PageHero
    title={heroTitle}
    subtitle={heroSubtitle}
    eyebrow={heroEyebrow}
    imageSrc={heroImage}
    imageAlt={heroImageAlt}
    ctaLabel={heroCtaLabel}
    ctaHref={heroCtaHref}
    ctaTrack={heroCtaTrack}
    secondaryLabel={heroSecondaryLabel}
    secondaryHref={heroSecondaryHref}
    secondaryTrack={heroSecondaryTrack}
  />
  <div class="container">
    <Breadcrumbs />
  </div>
  <slot />
  <FaqSection />
  <RelatedPages />
  {
    ctaTitle && ctaText && (
      <CtaBanner
        title={ctaTitle}
        text={ctaText}
        buttonLabel={ctaButtonLabel}
        buttonHref={ctaButtonHref}
        primaryTrack={ctaPrimaryTrack}
        extraLabel={extraLabel}
        extraHref={extraHref}
        extraTrack={extraTrack}
      />
    )
  }
  {closingVideo && closingVideoAlt && (
    <FullWidthVideo src={closingVideo} alt={closingVideoAlt} objectPosition={closingVideoPosition} />
  )}
</BaseLayout>
