---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import CtaBanner from './CtaBanner.astro';
import FullWidthVideo from './FullWidthVideo.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import FaqSection from '../seo/FaqSection.astro';
import RelatedPages from '../seo/RelatedPages.astro';

interface Props {
  title: string;
  description: string;
  heroTitle: string;
  heroSubtitle?: string;
  heroEyebrow?: string;
  heroImage?: string;
  heroImageMobile?: string;
  heroImageAlt?: string;
  heroImageAltMobile?: string;
  heroStillOnDesktop?: boolean;
  heroPhotoCredit?: string;
  heroCtaLabel?: string;
  heroCtaHref?: string;
  heroCtaTrack?: string;
  heroSecondaryLabel?: string;
  heroSecondaryHref?: string;
  heroSecondaryTrack?: string;
  ctaTitle?: string;
  ctaText?: string;
  ctaButtonLabel?: string;
  ctaButtonHref?: string;
  ctaPrimaryTrack?: string;
  extraLabel?: string;
  extraHref?: string;
  extraTrack?: string;
  closingVideo?: string;
  closingVideoAlt?: string;
  closingVideoPosition?: string;
  heroVideoDesktop?: string;
  heroVideoMobile?: string;
  heroPauseLabel?: string;
  heroPlayLabel?: string;
  heroVideoCredit?: string;
  index?: boolean;
}

const {
  title,
  description,
  heroTitle,
  heroSubtitle,
  heroEyebrow,
  heroImage,
  heroImageMobile,
  heroImageAlt,
  heroImageAltMobile,
  heroStillOnDesktop = false,
  heroPhotoCredit,
  heroCtaLabel,
  heroCtaHref,
  heroCtaTrack,
  heroSecondaryLabel,
  heroSecondaryHref,
  heroSecondaryTrack,
  ctaTitle,
  ctaText,
  ctaButtonLabel,
  ctaButtonHref,
  ctaPrimaryTrack,
  extraLabel,
  extraHref,
  extraTrack,
  closingVideo,
  closingVideoAlt,
  closingVideoPosition,
  heroVideoDesktop,
  heroVideoMobile,
  heroPauseLabel,
  heroPlayLabel,
  heroVideoCredit,
  index = true,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  index={index}
  lcpSrc={heroStillOnDesktop ? (heroImageMobile ?? heroImage) : heroImage}
  lcpSrcDesktop={heroStillOnDesktop ? heroImage : undefined}
>
  <PageHero
    title={heroTitle}
    subtitle={heroSubtitle}
    eyebrow={heroEyebrow}
    imageSrc={heroImage}
    imageSrcMobile={heroImageMobile}
    imageAlt={heroImageAlt}
    imageAltMobile={heroImageAltMobile}
    stillOnDesktop={heroStillOnDesktop}
    photoCredit={heroPhotoCredit}
    ctaLabel={heroCtaLabel}
    ctaHref={heroCtaHref}
    ctaTrack={heroCtaTrack}
    secondaryLabel={heroSecondaryLabel}
    secondaryHref={heroSecondaryHref}
    secondaryTrack={heroSecondaryTrack}
    videoDesktop={heroVideoDesktop}
    videoMobile={heroVideoMobile}
    pauseLabel={heroPauseLabel}
    playLabel={heroPlayLabel}
    videoCredit={heroVideoCredit}
  />
  <div class="page-below-hero">
    <div class="container">
      <Breadcrumbs />
    </div>
    <slot />
    <FaqSection />
    <RelatedPages />
    {
      ctaTitle && ctaText && (
        <CtaBanner
          title={ctaTitle}
          text={ctaText}
          buttonLabel={ctaButtonLabel}
          buttonHref={ctaButtonHref}
          primaryTrack={ctaPrimaryTrack}
          extraLabel={extraLabel}
          extraHref={extraHref}
          extraTrack={extraTrack}
        />
      )
    }
    {closingVideo && closingVideoAlt && (
      <FullWidthVideo src={closingVideo} alt={closingVideoAlt} objectPosition={closingVideoPosition} />
    )}
  </div>
</BaseLayout>
