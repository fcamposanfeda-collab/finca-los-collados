---
import { getOptimizedVideo } from '../../data/media';
import { useI18n } from '../../i18n';

interface Props {
  src: string;
  alt: string;
  class?: string;
  aspect?: 'landscape' | 'square' | 'wide';
  poster?: string;
  startTime?: number;
}

const {
  src,
  alt,
  class: className,
  aspect = 'landscape',
  poster,
  startTime = 0,
} = Astro.props;
const optimized = getOptimizedVideo(src);
const posterSrc = poster ?? optimized.poster;
const playLabel = (useI18n(Astro).copy.conversion as { playVideo: string }).playVideo;
---

<div
  class:list={['content-video', `content-video--${aspect}`, className]}
  data-deferred-video
  data-src={optimized.src}
  data-start-time={startTime > 0 ? startTime : undefined}
>
  {
    posterSrc && (
      <img src={posterSrc} alt={alt} width="960" height="720" loading="lazy" decoding="async" class="content-video__poster" />
    )
  }
  <button type="button" class="content-video__play" data-video-play>
    {playLabel}
  </button>
  <video muted loop playsinline preload="none" poster={posterSrc} aria-label={alt}></video>
</div>

<style>
  .content-video {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-bg-alt);
  }

  .content-video video,
  .content-video__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .content-video video {
    position: absolute;
    inset: 0;
  }

  .content-video__play {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    border: 0;
    background: rgba(44, 36, 25, 0.28);
    color: #fff;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .content-video.is-playing .content-video__play,
  .content-video.is-playing .content-video__poster {
    display: none;
  }

  .content-video--landscape {
    min-height: 16rem;
    aspect-ratio: 3 / 2;
  }

  .content-video--wide {
    min-height: 14rem;
    aspect-ratio: 16 / 9;
  }

  .content-video--square {
    aspect-ratio: 1;
  }

  @media (min-width: 768px) {
    .content-video__play {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .content-video video {
      display: none;
    }

    .content-video__play {
      display: flex;
    }
  }
</style>
