---
import OptimizedImage from './OptimizedImage.astro';

interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  aspect?: 'landscape' | 'square' | 'wide' | 'natural' | 'portrait';
}

const {
  src,
  alt,
  class: className,
  loading = 'lazy',
  fetchpriority = 'auto',
  aspect = 'landscape',
} = Astro.props;
---

<div class:list={['content-image', `content-image--${aspect}`, className]}>
  <OptimizedImage src={src} alt={alt} loading={loading} fetchpriority={fetchpriority} />
</div>

<style>
  .content-image {
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--color-bg-alt);
  }

  .content-image :global(picture),
  .content-image :global(img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .content-image :global(img) {
    object-fit: cover;
  }

  .content-image--landscape {
    min-height: 16rem;
    aspect-ratio: 4 / 3;
  }

  .content-image--wide {
    min-height: 14rem;
    aspect-ratio: 16 / 9;
  }

  .content-image--square {
    aspect-ratio: 1;
  }

  .content-image--portrait {
    aspect-ratio: 3 / 4;
    min-height: 18rem;
  }

  .content-image--natural {
    aspect-ratio: auto;
    min-height: 0;
  }

  .content-image--natural :global(img) {
    height: auto;
    object-fit: unset;
  }
</style>
