---
import { useI18n } from '../../i18n';

interface Props {
  title: string;
  text: string;
  buttonLabel?: string;
  buttonHref?: string;
  extraLabel?: string;
  extraHref?: string;
  extraTrack?: string;
  primaryTrack?: string;
}

const { href, t } = useI18n(Astro);
const {
  title,
  text,
  buttonLabel = t('common.reserve'),
  buttonHref = href('reservas-online'),
  extraLabel,
  extraHref,
  extraTrack,
  primaryTrack,
} = Astro.props;
const isExternal = buttonHref.startsWith('http') || buttonHref.startsWith('mailto:') || buttonHref.startsWith('#');
const extraIsExternal = extraHref
  ? extraHref.startsWith('http') || extraHref.startsWith('mailto:')
  : false;
---

<section class="cta-banner section" aria-labelledby="cta-banner-title">
  <div class="container cta-banner__inner">
    <div class="cta-banner__text">
      <h2 id="cta-banner-title" class="cta-banner__title">{title}</h2>
      <p class="cta-banner__desc">{text}</p>
    </div>
    <div class="cta-banner__actions">
      <a
        href={buttonHref}
        class="btn"
        data-track={primaryTrack}
        data-track-source="cta"
        target={isExternal && buttonHref.startsWith('http') ? '_blank' : undefined}
        rel={isExternal && buttonHref.startsWith('http') ? 'noopener noreferrer' : undefined}
      >
        {buttonLabel}
      </a>
      {
        extraLabel && extraHref && (
          <a
            href={extraHref}
            class="btn btn--outline cta-banner__outline"
            data-track={extraTrack}
            data-track-source="cta"
            target={extraIsExternal && extraHref.startsWith('http') ? '_blank' : undefined}
            rel={extraIsExternal && extraHref.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {extraLabel}
          </a>
        )
      }
      {
        !extraHref && (
          <a href={href('contacto')} class="btn btn--outline cta-banner__outline">
            {t('common.contact')}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta-banner {
    background: var(--color-bg);
    padding-block: 2rem;
  }

  .cta-banner__inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
    padding-block: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .cta-banner__text {
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
  }

  .cta-banner__title {
    margin: 0 0 0.35rem;
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    font-weight: 400;
    color: var(--color-text);
  }

  .cta-banner__desc {
    margin: 0;
    max-width: none;
    color: var(--color-muted);
    white-space: pre-line;
  }

  .cta-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    width: auto;
  }

  .cta-banner__actions .btn {
    flex: 0 0 auto;
    width: auto;
    min-width: min-content;
    min-height: 3rem;
    padding-inline: 1.35rem;
    text-align: center;
    white-space: nowrap;
  }

  .cta-banner__outline {
    border-color: var(--color-primary);
  }

  @media (min-width: 1024px) {
    .cta-banner {
      padding-block: 2.5rem;
    }

    .cta-banner__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }

    .cta-banner__text {
      width: auto;
    }

    .cta-banner__actions {
      width: auto;
      flex-shrink: 0;
    }

    .cta-banner__actions .btn {
      flex: 0 0 auto;
      width: auto;
      min-width: min-content;
    }
  }
</style>
