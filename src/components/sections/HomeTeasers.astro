---
import { images } from '../../data/images';
import ContentImage from '../ui/ContentImage.astro';
import { useI18n, type PageKey } from '../../i18n';

const { href, copy } = useI18n(Astro);
const teasers = copy.home.teasers as {
  title: string;
  lead: string;
  aria: string;
  items: { pageKey: PageKey; title: string; description: string }[];
};
---

<section class="section home-teasers" aria-label={teasers.aria}>
  <div class="container">
    <div class="home-teasers__head">
      <h2 class="section__title">{teasers.title}</h2>
      <p class="home-teasers__lead">{teasers.lead}</p>
    </div>
    <ul class="home-teasers__grid">
      {
        teasers.items.map((item) => (
          <li>
            <a href={href(item.pageKey)} class="home-teasers__card" data-track="nav" data-track-source="home-teasers">
              <div class="card-media">
                <ContentImage
                  src={images.teasers[item.pageKey as keyof typeof images.teasers]}
                  alt=""
                  aspect="natural"
                  class={item.pageKey === 'empresas' ? 'content-image--teaser-empresas' : undefined}
                />
              </div>
              <h3>
                {item.title}
                <span aria-hidden="true">→</span>
              </h3>
              <p>{item.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .home-teasers__head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .home-teasers__head .section__title {
    margin: 0;
  }

  .home-teasers__lead {
    margin: 0;
    max-width: 28rem;
    color: var(--color-muted);
  }

  .home-teasers__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-teasers__card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .home-teasers__card .card-media {
    overflow: hidden;
    border-radius: var(--radius);
  }

  .home-teasers__card .card-media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 600ms ease;
  }

  .home-teasers__card:hover .card-media :global(img) {
    transform: scale(1.04);
  }

  .home-teasers__card .card-media :global(.content-image--teaser-empresas img) {
    object-position: center 72%;
  }

  .home-teasers__card h3 {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 1rem 0 0.35rem;
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--color-text);
  }

  .home-teasers__card h3 span {
    color: var(--color-accent);
    transition: transform var(--transition-fast);
  }

  .home-teasers__card:hover h3 span {
    transform: translateX(4px);
  }

  .home-teasers__card p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (min-width: 768px) {
    .home-teasers__head {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 2rem;
    }

    .home-teasers__head .home-teasers__lead {
      text-align: right;
    }
  }

  @media (min-width: 1024px) {
    .home-teasers__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 3rem 1.5rem;
    }
  }
</style>
