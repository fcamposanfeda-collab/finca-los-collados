---
import { images } from '../../data/images';
import { bookingComPropertyUrl, buildPageWhatsAppUrl } from '../../data/booking';
import OptimizedImage from '../ui/OptimizedImage.astro';
import { useI18n } from '../../i18n';

const { locale, copy, t } = useI18n(Astro);
const hero = copy.home.hero as {
  eyebrow: string;
  title: string;
  subtitle: string;
  cta: string;
  aria: string;
};
const heroAlt = (copy.images as { heroHome: string }).heroHome;
const bookingUrl = bookingComPropertyUrl(locale);
const whatsappUrl = buildPageWhatsAppUrl('home', locale);
const bookingLabel = (copy.booking as { bookingComLabel: string }).bookingComLabel;
---

<section class="hero hero--photo" aria-label={hero.aria}>
  <OptimizedImage
    class="hero__img"
    src={images.hero.home}
    alt={heroAlt}
    width={1920}
    height={1080}
    loading="eager"
    fetchpriority="high"
    sizes="100vw"
  />
  <div class="hero__overlay"></div>
  <div class="container hero__content">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="hero__title">{hero.title}</h1>
    <p class="hero__subtitle">{hero.subtitle}</p>
    <div class="hero__actions">
      <a
        href={bookingUrl}
        class="btn"
        data-track="booking"
        data-track-source="hero"
        target="_blank"
        rel="noopener noreferrer"
      >
        {bookingLabel}
      </a>
      <a
        href={whatsappUrl}
        class="btn btn--outline"
        data-track="whatsapp"
        data-track-source="hero"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('common.whatsapp')}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(28rem, 70vh, 40rem);
    background:
      linear-gradient(135deg, rgba(44, 36, 25, 0.75), rgba(74, 103, 65, 0.65)),
      radial-gradient(ellipse at 70% 30%, rgba(201, 169, 110, 0.25), transparent 50%),
      var(--color-secondary);
    color: var(--color-on-primary);
  }

  .hero--photo {
    overflow: hidden;
    background: var(--color-secondary);
  }

  .hero :global(picture.hero__img),
  .hero :global(img.hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero :global(.hero__img img),
  .hero :global(img.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    max-width: none;
    transform: scale(1);
    transform-origin: 50% 38%;
    animation: hero-zoom 5s ease-in-out 2.5s infinite alternate;
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1);
    }

    to {
      transform: scale(1.2);
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to top, rgba(44, 36, 25, 0.4), transparent 60%),
      linear-gradient(135deg, rgba(44, 36, 25, 0.72), rgba(74, 103, 65, 0.62));
  }

  @media (prefers-reduced-motion: reduce) {
    .hero :global(.hero__img img),
    .hero :global(img.hero__img) {
      animation: none;
      transform: none;
    }
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 40rem;
    padding-block: 4rem;
  }

  .hero__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__title {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    color: var(--color-on-primary);
    line-height: 1.15;
  }

  .hero__subtitle {
    margin: 0 0 2rem;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    color: rgba(255, 255, 255, 0.9);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__actions .btn {
    width: auto;
    min-width: min-content;
    white-space: nowrap;
    padding-inline: 1.35rem;
  }

  .hero__actions .btn--outline {
    color: var(--color-on-primary);
    border-color: var(--color-on-primary);
  }

  .hero__actions .btn--outline:hover {
    color: var(--color-text);
    background: var(--color-on-primary);
    border-color: var(--color-on-primary);
  }
</style>
