---
import { images } from '../../data/images';
import { bookingComPropertyUrl, buildPageWhatsAppUrl } from '../../data/booking';
import { getHomeHeroLoop } from '../../data/media';
import OptimizedImage from '../ui/OptimizedImage.astro';
import { useI18n } from '../../i18n';

const { locale, copy, t } = useI18n(Astro);
const hero = copy.home.hero as {
  eyebrow: string;
  title: string;
  subtitle: string;
  cta: string;
  aria: string;
};
const heroAlt = (copy.images as { heroHome: string }).heroHome;
const bookingUrl = bookingComPropertyUrl(locale);
const whatsappUrl = buildPageWhatsAppUrl('home', locale);
const bookingLabel = (copy.booking as { bookingComLabel: string }).bookingComLabel;
const conv = copy.conversion as { playVideo: string; pauseVideo: string };
const heroLoop = getHomeHeroLoop();
---

<section class="hero hero--photo" aria-label={hero.aria} data-hero>
  <OptimizedImage
    class="hero__img"
    src={images.hero.home}
    alt={heroAlt}
    width={1920}
    height={1080}
    loading="eager"
    fetchpriority="high"
    sizes="100vw"
  />
  {
    heroLoop.desktop && (
      <video
        class="hero__video"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        data-src-desktop={heroLoop.desktop}
        data-src-mobile={heroLoop.mobile ?? heroLoop.desktop}
      ></video>
    )
  }
  <div class="hero__overlay"></div>
  <div class="container hero__content">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="hero__title">{hero.title}</h1>
    <p class="hero__subtitle">{hero.subtitle}</p>
    <div class="hero__actions">
      <a
        href={bookingUrl}
        class="btn"
        data-track="booking"
        data-track-source="hero"
        target="_blank"
        rel="noopener noreferrer"
      >
        {bookingLabel}
      </a>
      <a
        href={whatsappUrl}
        class="btn btn--outline"
        data-track="whatsapp"
        data-track-source="hero"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('common.whatsapp')}
      </a>
    </div>
  </div>
  {
    heroLoop.desktop && (
      <button
        type="button"
        class="hero__video-toggle"
        data-hero-video-toggle
        hidden
        aria-label={conv.pauseVideo}
        data-label-pause={conv.pauseVideo}
        data-label-play={conv.playVideo}
      >
        <span class="hero__video-toggle-icon" aria-hidden="true"></span>
      </button>
    )
  }
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    margin-top: calc(-1 * var(--header-height));
    min-height: 32rem;
    height: 100svh;
    max-height: 54rem;
    background: var(--color-footer-bg);
    color: var(--color-on-dark);
  }

  .hero--photo {
    overflow: hidden;
    background: var(--color-footer-bg);
  }

  .hero :global(picture.hero__img),
  .hero :global(img.hero__img) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
  }

  .hero :global(.hero__img img),
  .hero :global(img.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    max-width: none;
  }

  .hero__video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .hero__video.is-ready {
    opacity: 1;
  }

  .hero__video-toggle[hidden] {
    display: none;
  }

  .hero__video-toggle {
    position: absolute;
    top: calc(var(--header-height) + 0.65rem);
    right: 0.75rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    color: #fff;
    background: rgb(28 25 20 / 0.42);
    cursor: pointer;
  }

  .hero__video-toggle:hover,
  .hero__video-toggle:focus-visible {
    background: rgb(28 25 20 / 0.62);
  }

  .hero__video-toggle-icon {
    display: block;
    width: 0.7rem;
    height: 0.85rem;
    border-inline: 0.18rem solid currentColor;
  }

  .hero__video-toggle.is-paused .hero__video-toggle-icon {
    width: 0;
    height: 0;
    border: 0.42rem solid transparent;
    border-left: 0.7rem solid currentColor;
    border-inline: 0;
    border-left-width: 0.7rem;
    margin-left: 0.15rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video,
    .hero__video-toggle {
      display: none;
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      var(--color-hero-veil-strong) 0%,
      var(--color-hero-veil) 45%,
      rgb(28 25 20 / 0.22) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: var(--container-text);
    padding-block: 4rem 3.5rem;
    padding-top: calc(var(--header-height) + 2.75rem);
    padding-bottom: calc(1.5rem + 3.25rem + env(safe-area-inset-bottom, 0px));
  }

  .hero__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-primary);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: var(--letter-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__title {
    margin: 0 0 1rem;
    font-weight: 400;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    color: var(--color-on-dark);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero__subtitle {
    margin: 0 0 2rem;
    max-width: 36rem;
    font-size: clamp(1.0625rem, 2vw, 1.2rem);
    color: rgb(244 239 230 / 0.88);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .hero__content {
      padding-bottom: 3.5rem;
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__actions .btn {
    width: auto;
    min-width: min-content;
    white-space: nowrap;
    padding-inline: 1.35rem;
  }

  .hero__actions .btn--outline {
    color: var(--color-on-primary);
    border-color: var(--color-on-primary);
  }

  .hero__actions .btn--outline:hover {
    color: var(--color-text);
    background: var(--color-on-primary);
    border-color: var(--color-on-primary);
  }
</style>

<script>
  const hero = document.querySelector('[data-hero]');
  const video = hero?.querySelector<HTMLVideoElement>('.hero__video');
  const toggle = hero?.querySelector<HTMLButtonElement>('[data-hero-video-toggle]');

  function prefersStatic(): boolean {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return true;
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    return Boolean(connection?.saveData);
  }

  function sourceForViewport(): string | undefined {
    if (!video) return undefined;
    const mobile = window.matchMedia('(max-width: 767px)').matches;
    return mobile ? video.dataset.srcMobile : video.dataset.srcDesktop;
  }

  function syncToggle(): void {
    if (!video || !toggle) return;
    const paused = video.paused;
    toggle.classList.toggle('is-paused', paused);
    const label = paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause;
    if (label) toggle.setAttribute('aria-label', label);
  }

  function startVideo(): void {
    if (!video || prefersStatic()) return;
    const src = sourceForViewport();
    if (!src) return;
    const onPlaying = () => {
      video.classList.add('is-ready');
      if (toggle) {
        toggle.hidden = false;
        syncToggle();
      }
    };
    video.addEventListener('playing', onPlaying, { once: true });
    video.src = src;
    video.play().then(syncToggle).catch(() => {
      video.removeEventListener('playing', onPlaying);
    });
  }

  function scheduleStart(): void {
    const startedAt = performance.now();
    const run = () => {
      const wait = Math.max(0, 3000 - (performance.now() - startedAt));
      window.setTimeout(startVideo, wait);
    };
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(run, { timeout: 2000 });
    } else {
      run();
    }
  }

  if (video) {
    if (document.readyState === 'complete') scheduleStart();
    else window.addEventListener('load', scheduleStart, { once: true });
    toggle?.addEventListener('click', () => {
      if (video.paused) {
        video.play().then(syncToggle).catch(() => {});
      } else {
        video.pause();
        syncToggle();
      }
    });
  }
</script>
