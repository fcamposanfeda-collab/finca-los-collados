---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageMeta } from '../data/pages-meta';
import { legalPageKeys, pagePathname, useI18n, type LegalPageKey } from '../i18n';

const { locale, pageKey, copy } = useI18n(Astro);
const legalKey = (legalPageKeys.includes(pageKey as LegalPageKey) ? pageKey : 'politica-de-privacidad') as LegalPageKey;
const meta = getPageMeta(legalKey, locale);
const legal = copy.legal as {
  disclaimer: string;
  placeholderLead: string;
  titles: Record<string, string>;
};
const legalTitle = legal.titles[legalKey];
const sourcePath = pagePathname(legalKey, 'es');
---

<BaseLayout title={meta.title} description={meta.description}>
  <section class="section">
    <div class="container legal">
      <h1>{legalTitle}</h1>
      {legal.disclaimer && <p class="legal__disclaimer">{legal.disclaimer}</p>}
      <p class="legal__notice">
        {legal.placeholderLead}{' '}
        <a href={`https://loscolladosdesanmiguel.com${sourcePath}`}>loscolladosdesanmiguel.com{sourcePath}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    max-width: 48rem;
  }

  .legal h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    color: var(--color-secondary);
  }

  .legal__disclaimer {
    margin: 0 0 1.25rem;
    padding: 0.875rem 1rem;
    background: var(--color-bg-alt);
    border-left: 3px solid var(--color-primary);
    color: var(--color-text);
    line-height: 1.7;
  }

  .legal__notice {
    color: var(--color-muted);
    line-height: 1.7;
  }

  .legal__notice a {
    color: var(--color-primary);
    font-weight: 500;
  }
</style>
