---
import { booking } from '../../data/booking';
import { useI18n } from '../../i18n';

const { copy, t } = useI18n(Astro);
const widget = copy.booking.widget as { title: string; pending: string; pendingText: string };
---

<section class="booking-widget section section--alt" data-booking-widget aria-labelledby="booking-widget-title">
  <div class="container">
    <h2 id="booking-widget-title" class="section__title">{widget.title}</h2>

    {
      booking.provider === 'iframe' && booking.widget.iframeUrl ? (
        <div class="booking-widget__frame-wrap">
          <iframe
            src={booking.widget.iframeUrl}
            title={t('booking.widgetTitle')}
            class="booking-widget__iframe"
            style={`min-height: ${booking.widget.iframeHeight}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      ) : booking.provider === 'script' && booking.widget.scriptUrl ? (
        <div class="booking-widget__script-wrap" id="booking-widget-root">
          <script is:inline src={booking.widget.scriptUrl} defer />
        </div>
      ) : (
        <div class="booking-widget__pending">
          <p>
            <strong>{widget.pending}</strong> {widget.pendingText}
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  .booking-widget__frame-wrap {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg);
  }

  .booking-widget__iframe {
    display: block;
    width: 100%;
    border: 0;
  }

  .booking-widget__script-wrap {
    min-height: 24rem;
  }

  .booking-widget__pending {
    max-width: 40rem;
    margin-inline: auto;
    padding: 1.5rem;
    background: var(--color-bg);
    border: 1px dashed var(--color-border);
    border-radius: 0.5rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .booking-widget__pending strong {
    color: var(--color-secondary);
  }
</style>
