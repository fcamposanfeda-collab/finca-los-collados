---
import { booking, buildWhatsAppUrl, bookingComPropertyUrl } from '../../data/booking';
import { contact } from '../../data/contact';
import { useI18n } from '../../i18n';

const { locale, copy } = useI18n(Astro);
const alt = copy.booking.alternatives as {
  title: string;
  bookingTitle: string;
  bookingText: string;
  bookingLink: string;
  whatsappTitle: string;
  whatsappText: string;
  whatsappButton: string;
  phoneTitle: string;
  phoneText: string;
};
const bookingUrl = bookingComPropertyUrl(locale);
const [bookingBefore, bookingAfter] = alt.bookingText.split('{link}');
---

<section class="booking-alternatives section" aria-labelledby="booking-alt-title">
  <div class="container">
    <h2 id="booking-alt-title" class="section__title">{alt.title}</h2>

    <div class="booking-alternatives__grid">
      {
        booking.bookingCom.enabled && (
          <article class="booking-alternatives__card">
            <h3>{alt.bookingTitle}</h3>
            <p>
              {bookingBefore}<a href={bookingUrl} target="_blank" rel="noopener noreferrer">{alt.bookingLink}</a>{bookingAfter}
            </p>
            <a
              href={bookingUrl}
              class="btn btn--outline"
              data-track="booking"
              data-track-source="alternatives"
              target="_blank"
              rel="noopener noreferrer"
            >
              {(copy.booking as { bookingComLabel: string }).bookingComLabel}
            </a>
          </article>
        )
      }

      {
        booking.whatsapp.enabled && (
          <article class="booking-alternatives__card">
            <h3>{alt.whatsappTitle}</h3>
            <p>{alt.whatsappText}</p>
            <a
              href={buildWhatsAppUrl({}, locale)}
              class="btn btn--outline"
              data-track="whatsapp"
              data-track-source="alternatives"
              target="_blank"
              rel="noopener noreferrer"
            >
              {alt.whatsappButton}
            </a>
          </article>
        )
      }

      <article class="booking-alternatives__card">
        <h3>{alt.phoneTitle}</h3>
        <p>{alt.phoneText}</p>
        <p class="booking-alternatives__phones">
          <a href={`tel:${contact.phone}`} data-track="phone" data-track-source="alternatives">{contact.phoneDisplay}</a>
          <a href={`tel:${contact.phoneAlt}`} data-track="phone" data-track-source="alternatives">{contact.phoneAltDisplay}</a>
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .booking-alternatives__grid {
    display: grid;
    gap: 1.25rem;
  }

  .booking-alternatives__card {
    padding: 1.5rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    text-align: center;
  }

  .booking-alternatives__card h3 {
    margin: 0 0 0.75rem;
    font-size: 1.125rem;
    color: var(--color-secondary);
  }

  .booking-alternatives__card p {
    margin: 0 0 1.25rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .booking-alternatives__phones {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .booking-alternatives__phones a {
    font-weight: 600;
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .booking-alternatives__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
