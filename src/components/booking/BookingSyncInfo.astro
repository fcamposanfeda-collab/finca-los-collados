---
import { useI18n } from '../../i18n';

const { copy } = useI18n(Astro);
const sync = copy.booking.sync as { title: string; paragraphs: string[] };
---

<section class="booking-sync section section--alt" aria-labelledby="booking-sync-title">
  <div class="container booking-sync__inner">
    <h2 id="booking-sync-title">{sync.title}</h2>
    {sync.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>

<style>
  .booking-sync__inner {
    max-width: 48rem;
    margin-inline: auto;
  }

  .booking-sync__inner h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    color: var(--color-secondary);
    text-align: center;
  }

  .booking-sync__inner p {
    margin: 0 0 1rem;
    color: var(--color-muted);
    line-height: 1.7;
  }
</style>
