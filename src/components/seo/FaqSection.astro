---
import { useI18n, type PageKey } from '../../i18n';
import { visibleFaqItems } from '../../data/hunting';

interface Props {
  page?: PageKey;
}

const { pageKey, copy } = useI18n(Astro);
const faqPage = (Astro.props.page ?? pageKey) as string;
const faqCopy = copy.faq as Record<string, unknown>;
const items = Array.isArray(faqCopy[faqPage])
  ? visibleFaqItems(faqCopy[faqPage] as { q: string; a: string }[])
  : [];
const title = faqCopy.title as string;
---

{
  items.length > 0 && (
    <section class="faq-section section" aria-labelledby="faq-title">
      <div class="container">
        <h2 id="faq-title" class="section__title">
          {title}
        </h2>
        <div class="faq-section__list">
          {items.map((item) => (
            <details class="faq-section__item">
              <summary class="faq-section__q">
                <span class="faq-section__q-text">{item.q}</span>
                <span class="faq-section__icon" aria-hidden="true"></span>
              </summary>
              <p class="faq-section__a">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq-section__list {
    max-width: 46rem;
    margin: 0;
    display: grid;
  }

  .faq-section__item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-section__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin: 0;
    padding: 0.95rem 0;
    min-height: 2.75rem;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }

  .faq-section__q:hover .faq-section__q-text {
    color: var(--color-primary);
  }

  .faq-section__q:focus {
    outline: none;
  }

  .faq-section__q:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: 4px;
  }

  .faq-section :global(summary.faq-section__q)::marker {
    content: none;
  }

  .faq-section :global(summary.faq-section__q)::-webkit-details-marker {
    display: none;
  }

  .faq-section__icon {
    flex-shrink: 0;
    width: 0.42rem;
    height: 0.42rem;
    margin-top: -0.12rem;
    border-right: 1px solid var(--color-primary);
    border-bottom: 1px solid var(--color-primary);
    transform: rotate(45deg);
    transition: transform var(--transition-med);
  }

  .faq-section__item[open] .faq-section__icon {
    margin-top: 0.12rem;
    transform: rotate(225deg);
  }

  .faq-section__a {
    margin: 0 0 1.1rem;
    padding-right: 2rem;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-section__icon {
      transition: none;
    }
  }
</style>
