---
import { useI18n, type PageKey } from '../../i18n';
import { visibleFaqItems } from '../../data/hunting';

interface Props {
  page?: PageKey;
}

const { pageKey, copy } = useI18n(Astro);
const faqPage = (Astro.props.page ?? pageKey) as string;
const faqCopy = copy.faq as Record<string, unknown>;
const items = Array.isArray(faqCopy[faqPage])
  ? visibleFaqItems(faqCopy[faqPage] as { q: string; a: string }[])
  : [];
const title = faqCopy.title as string;
---

{
  items.length > 0 && (
    <section class="faq-section section" aria-labelledby="faq-title">
      <div class="container">
        <h2 id="faq-title" class="section__title">
          {title}
        </h2>
        <div class="faq-section__list">
          {items.map((item) => (
            <details class="faq-section__item">
              <summary class="faq-section__q">
                <span>{item.q}</span>
                <svg
                  class="faq-section__icon"
                  width="16"
                  height="16"
                  viewBox="0 0 12 12"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M2.5 4.25 6 7.75 9.5 4.25"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </summary>
              <p class="faq-section__a">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq-section {
    padding-block: 2rem;
  }

  .faq-section__list {
    max-width: 46rem;
    margin: 0;
    display: grid;
    gap: 0;
  }

  .faq-section__item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-section__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 1.1rem 0;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-text);
  }

  .faq-section__q::-webkit-details-marker {
    display: none;
  }

  .faq-section__q::marker {
    content: none;
  }

  .faq-section__q:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 0.25rem;
  }

  .faq-section__icon {
    display: block;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    color: var(--color-secondary);
    transform-origin: 50% 50%;
    transition: transform 0.2s ease;
  }

  .faq-section__item[open] .faq-section__icon {
    transform: rotate(180deg);
  }

  .faq-section__a {
    margin: 0 0 1.15rem;
    max-width: var(--measure);
    color: var(--color-muted);
  }

  @media (min-width: 768px) {
    .faq-section {
      padding-top: 2.5rem;
      padding-bottom: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-section__icon {
      transition: none;
    }
  }
</style>
