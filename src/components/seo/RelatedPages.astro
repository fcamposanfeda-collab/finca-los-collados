---
import { useI18n, type PageKey } from '../../i18n';

const { pageKey, href, copy } = useI18n(Astro);
const conv = copy.conversion as {
  relatedTitle: string;
  related: Partial<Record<PageKey, PageKey[]>>;
};
const navLabels = copy.nav as Record<string, string>;
const related = conv.related[pageKey] ?? [];
---

{
  related.length > 0 && (
    <section class="related-pages section" aria-labelledby="related-pages-title">
      <div class="related-pages__panel">
        <h2 id="related-pages-title" class="section__title">
          {conv.relatedTitle}
        </h2>
        <ul class="related-pages__list">
          {related.map((key) => (
            <li>
              <a href={href(key)}>{navLabels[key] ?? key}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .related-pages {
    padding-block: 1.75rem;
  }

  .related-pages__panel {
    width: calc(100% - 3rem);
    max-width: 48rem;
    margin-inline: auto;
    padding: 1.75rem clamp(1.5rem, 4vw, 2.5rem) 1.85rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius);
  }

  .related-pages__panel .section__title {
    margin-bottom: 1rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .related-pages__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.5rem 1rem;
  }

  .related-pages__list a {
    display: inline-flex;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: transparent;
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast),
      background var(--transition-fast);
  }

  .related-pages__list a:hover,
  .related-pages__list a:focus-visible {
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .related-pages {
      padding-block: 2.25rem;
    }
  }
</style>
