---
import { inquiryOptions, isEmailFormConfigured, resolveInquirySubject, spanishSubjectLabel } from '../../data/forms';
import { forms } from '../../data/forms';
import { contact } from '../../data/contact';
import { localeMeta, localizePath, msg, useI18n } from '../../i18n';

interface Props {
  title?: string;
  intro?: string;
  showPhone?: boolean;
  showDates?: boolean;
  showGuests?: boolean;
  defaultSubject?: string;
  formId?: string;
}

const { locale, copy, t, href } = useI18n(Astro);
const formCopy = copy.forms as {
  title: string;
  intro: string;
  name: string;
  email: string;
  phone: string;
  subject: string;
  checkIn: string;
  checkOut: string;
  guests: string;
  message: string;
  submit: string;
  sending: string;
  sendError: string;
  configuredNote: string;
  mailtoFallback: string;
  defaultSubject: string;
  emailLabels: Record<string, string>;
  required: string;
  privacyAccept: string;
  privacyPolicy: string;
  privacyLayer: string;
  privacyError: string;
  requiredError: string;
  emailError: string;
};

const {
  title = formCopy.title,
  intro = formCopy.intro,
  showPhone = true,
  showDates = false,
  showGuests = false,
  defaultSubject = 'general',
  formId = 'contact',
} = Astro.props;

const urlMotivo = resolveInquirySubject(Astro.url.searchParams.get('motivo'));
const selectedSubject = urlMotivo ?? defaultSubject;

const idPrefix = formId;
const configured = isEmailFormConfigured();
const successUrl = localizePath('solicitud-enviada', locale);
const options = inquiryOptions(locale);
const languageField = localeMeta[locale].languageField;
const showAdminNote = import.meta.env.DEV && !configured;
const mailtoSubject = t('common.mailtoSubject');
const spanishEmailLabels = (msg('es').forms as { emailLabels: Record<string, string> }).emailLabels;
const privacyHref = href('politica-de-privacidad');
const mailtoFallbackHtml = formCopy.mailtoFallback
  .replace(
    '{email}',
    `<a href="mailto:${contact.email}?subject=${encodeURIComponent(mailtoSubject)}">${contact.email}</a>`,
  )
  .replace('{phone}', `<a href="tel:${contact.phone}">${contact.phoneDisplay}</a>`);

const [privacyAcceptBefore, privacyAcceptAfter] = formCopy.privacyAccept.split('{policy}');
const [layerBeforePolicy, layerAfterPolicy] = formCopy.privacyLayer
  .replace('{email}', contact.email)
  .split('{policy}');
---

<section class="contact-form section" aria-labelledby={`${idPrefix}-form-title`}>
  <div class="container">
    {title && <h2 id={`${idPrefix}-form-title`} class="section__title">{title}</h2>}
    {intro && <p class="contact-form__intro">{intro}</p>}

    <form
      class="contact-form__form"
      data-contact-form={formId}
      data-default-subject={selectedSubject}
      lang={localeMeta[locale].htmlLang}
    >
      <input type="hidden" name="idioma" value={languageField} />
      <div class="contact-form__hp" aria-hidden="true">
        <label>
          Leave this field empty
          <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <div class="contact-form__grid">
        <div class="contact-form__field">
          <label for={`${idPrefix}-nombre`}>
            {formCopy.name} <span class="contact-form__req">({formCopy.required})</span>
          </label>
          <input
            id={`${idPrefix}-nombre`}
            name="name"
            type="text"
            required
            autocomplete="name"
            aria-required="true"
          />
        </div>
        <div class="contact-form__field">
          <label for={`${idPrefix}-email`}>
            {formCopy.email} <span class="contact-form__req">({formCopy.required})</span>
          </label>
          <input
            id={`${idPrefix}-email`}
            name="email"
            type="email"
            required
            autocomplete="email"
            aria-required="true"
          />
        </div>
        {
          showPhone && (
            <div class="contact-form__field">
              <label for={`${idPrefix}-telefono`}>{formCopy.phone}</label>
              <input id={`${idPrefix}-telefono`} name="phone" type="tel" autocomplete="tel" />
            </div>
          )
        }
        <div class="contact-form__field">
          <label for={`${idPrefix}-motivo`}>
            {formCopy.subject} <span class="contact-form__req">({formCopy.required})</span>
          </label>
          <select id={`${idPrefix}-motivo`} name="subject" required aria-required="true">
            {
              options.map((item) => (
                <option value={item.value} data-package-id={item.value} selected={item.value === selectedSubject}>
                  {item.label}
                </option>
              ))
            }
          </select>
        </div>
        {
          showDates && (
            <>
              <div class="contact-form__field">
                <label for={`${idPrefix}-entrada`}>{formCopy.checkIn}</label>
                <input id={`${idPrefix}-entrada`} name="checkIn" type="date" lang={localeMeta[locale].htmlLang} />
              </div>
              <div class="contact-form__field">
                <label for={`${idPrefix}-salida`}>{formCopy.checkOut}</label>
                <input id={`${idPrefix}-salida`} name="checkOut" type="date" lang={localeMeta[locale].htmlLang} />
              </div>
            </>
          )
        }
        {
          showGuests && (
            <div class="contact-form__field">
              <label for={`${idPrefix}-invitados`}>{formCopy.guests}</label>
              <input id={`${idPrefix}-invitados`} name="guests" type="number" min="1" max="50" />
            </div>
          )
        }
      </div>

      <div class="contact-form__field">
        <label for={`${idPrefix}-mensaje`}>
          {formCopy.message} <span class="contact-form__req">({formCopy.required})</span>
        </label>
        <textarea id={`${idPrefix}-mensaje`} name="message" rows="5" required aria-required="true" />
      </div>

      <div class="contact-form__privacy">
        <label class="contact-form__consent" for={`${idPrefix}-privacy`}>
          <input
            id={`${idPrefix}-privacy`}
            name="privacy"
            type="checkbox"
            value="accepted"
            required
            aria-required="true"
          />
          <span>
            {privacyAcceptBefore}
            <a href={privacyHref}>{formCopy.privacyPolicy}</a>
            {privacyAcceptAfter}
          </span>
        </label>
        <p class="contact-form__layer">
          {layerBeforePolicy}
          <a href={privacyHref}>{formCopy.privacyPolicy}</a>
          {layerAfterPolicy}
        </p>
      </div>

      <button type="submit" class="btn">{formCopy.submit}</button>
      <p class="contact-form__note" data-form-status hidden></p>
      <p class="contact-form__note">
        {
          configured ? (
            <>
              {formCopy.configuredNote.split('{email}')[0]}
              <a href={`mailto:${contact.email}?subject=${encodeURIComponent(mailtoSubject)}`}>
                {contact.email}
              </a>
              {formCopy.configuredNote.split('{email}')[1] ?? ''}
            </>
          ) : showAdminNote ? (
            <>
              {t('forms.devNote').split('{email}')[0]}
              <a href={`mailto:${contact.email}?subject=${encodeURIComponent(mailtoSubject)}`}>
                {contact.email}
              </a>
              {t('forms.devNote').split('{email}')[1] ?? ''}
            </>
          ) : (
            <>
              <a href={`mailto:${contact.email}?subject=${encodeURIComponent(mailtoSubject)}`}>
                {contact.email}
              </a>
            </>
          )
        }
      </p>
    </form>
  </div>
</section>

<script define:vars={{
  formId,
  endpoint: forms.endpoint,
  accessKey: forms.web3formsAccessKey,
  recipientEmail: forms.recipientEmail,
  configured,
  successUrl,
  mailtoFallbackHtml,
  sendingLabel: formCopy.sending,
  sendError: formCopy.sendError,
  mailtoSubject,
  languageField,
  emailLabels: spanishEmailLabels,
  spanishSubjects: Object.fromEntries(
    (['general','alojamiento','finca-espacios','finca-completa','finca-fin-semana','sesiones-fotograficas','evento','empresa','pack','caza'] as const).map((id) => [id, spanishSubjectLabel(id)]),
  ),
  subjectPrefix: spanishEmailLabels.subjectPrefix,
  requiredError: formCopy.requiredError,
  emailError: formCopy.emailError,
  privacyError: formCopy.privacyError,
  locale,
}}>
  const form = document.querySelector(`[data-contact-form="${formId}"]`);
  const statusEl = form?.querySelector('[data-form-status]');
  const submitBtn = form?.querySelector('button[type="submit"]');
  const subjectSelect = form?.querySelector('select[name="subject"]');
  const subjectAliases = {
    general: 'general',
    alojamiento: 'alojamiento',
    bungalows: 'alojamiento',
    accommodation: 'alojamiento',
    hebergement: 'alojamiento',
    'finca-espacios': 'finca-espacios',
    'finca-completa': 'finca-completa',
    finca: 'finca-completa',
    'finca-fin-semana': 'finca-fin-semana',
    'sesiones-fotograficas': 'sesiones-fotograficas',
    rodaje: 'sesiones-fotograficas',
    rodajes: 'sesiones-fotograficas',
    shooting: 'sesiones-fotograficas',
    shootings: 'sesiones-fotograficas',
    evento: 'evento',
    eventos: 'evento',
    events: 'evento',
    evenements: 'evento',
    empresa: 'empresa',
    empresas: 'empresa',
    corporate: 'empresa',
    teambuilding: 'empresa',
    pack: 'pack',
    packs: 'pack',
    packages: 'pack',
    formules: 'pack',
    caza: 'caza',
    chasse: 'caza',
    shootingday: 'caza',
  };

  const motivo = new URLSearchParams(window.location.search).get('motivo')?.trim().toLowerCase();
  const mapped = motivo ? subjectAliases[motivo] : undefined;
  if (mapped && subjectSelect instanceof HTMLSelectElement) {
    const option = [...subjectSelect.options].find((item) => item.value === mapped);
    if (option) subjectSelect.value = mapped;
  }

  function setValidityMessage(field, message) {
    if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement)) {
      return;
    }
    field.setCustomValidity(field.validity.valueMissing || field.validity.typeMismatch ? message : '');
  }

  form?.querySelectorAll('[required]').forEach((field) => {
    const message = field.getAttribute('name') === 'privacy'
      ? privacyError
      : field.getAttribute('name') === 'email'
        ? emailError
        : requiredError;
    field.addEventListener('invalid', () => setValidityMessage(field, message));
    field.addEventListener('input', () => {
      if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
        field.setCustomValidity('');
      }
    });
    field.addEventListener('change', () => {
      if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
        field.setCustomValidity('');
      }
    });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const data = new FormData(form);
    if (data.get('botcheck')) {
      return;
    }

    const subjectId = String(data.get('subject') ?? 'general');
    const spanishSubject = spanishSubjects[subjectId] ?? subjectId;
    const payload = {
      name: String(data.get('name') ?? ''),
      email: String(data.get('email') ?? ''),
      phone: String(data.get('phone') ?? ''),
      subjectId,
      message: String(data.get('message') ?? ''),
      checkIn: String(data.get('checkIn') ?? ''),
      checkOut: String(data.get('checkOut') ?? ''),
      guests: String(data.get('guests') ?? ''),
      idioma: String(data.get('idioma') ?? languageField),
    };

    const fullMessage = [
      `${emailLabels.name}: ${payload.name}`,
      `${emailLabels.email}: ${payload.email}`,
      payload.phone ? `${emailLabels.phone}: ${payload.phone}` : '',
      payload.checkIn ? `${emailLabels.checkIn}: ${payload.checkIn}` : '',
      payload.checkOut ? `${emailLabels.checkOut}: ${payload.checkOut}` : '',
      payload.guests ? `${emailLabels.guests}: ${payload.guests}` : '',
      `${emailLabels.language}: ${payload.idioma}`,
      '',
      payload.message,
    ]
      .filter((line, index, arr) => line !== '' || arr[index - 1] === '')
      .join('\n');

    if (statusEl) {
      statusEl.hidden = false;
      statusEl.textContent = sendingLabel;
      statusEl.classList.remove('is-error', 'is-success');
    }

    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = true;
    }

    window.trackConversion?.('form_submit', { locale, motivo: subjectId });

    if (!configured) {
      const params = new URLSearchParams({
        subject: spanishSubject,
        body: fullMessage,
      });
      window.location.href = `mailto:${recipientEmail}?${params.toString()}`;
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = false;
      }
      if (statusEl) {
        statusEl.innerHTML = mailtoFallbackHtml;
        statusEl.classList.add('is-success');
        statusEl.classList.remove('is-error');
      }
      return;
    }

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: accessKey,
          subject: `${subjectPrefix} ${spanishSubject}`,
          name: payload.name,
          email: payload.email,
          message: fullMessage,
          idioma: payload.idioma,
          botcheck: false,
        }),
      });

      const result = await response.json();
      if (!response.ok || !result.success) {
        throw new Error(result.message || 'Error');
      }

      window.location.href = successUrl;
    } catch {
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = false;
      }
      if (statusEl) {
        statusEl.innerHTML = sendError.replace(
          '{email}',
          '<a href="mailto:' +
            recipientEmail +
            '?subject=' +
            encodeURIComponent(mailtoSubject) +
            '">' +
            recipientEmail +
            '</a>',
        );
        statusEl.classList.add('is-error');
      }
    }
  });
</script>

<style>
  .contact-form__intro {
    max-width: 42rem;
    margin: 0 auto 2rem;
    text-align: center;
    color: var(--color-muted);
  }

  .contact-form__form {
    position: relative;
    max-width: 40rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-form__hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form__grid {
    display: grid;
    gap: 1rem;
  }

  .contact-form__field label {
    display: block;
    margin-bottom: 0.375rem;
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .contact-form__req {
    font-weight: 400;
    color: var(--color-muted);
    font-size: 0.8125rem;
  }

  .contact-form__field input,
  .contact-form__field textarea,
  .contact-form__field select {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .contact-form__privacy {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-form__consent {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .contact-form__consent input {
    margin-top: 0.2rem;
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
    accent-color: var(--color-primary);
  }

  .contact-form__consent a,
  .contact-form__layer a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .contact-form__layer {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .contact-form__note {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .contact-form__note.is-success {
    color: var(--color-primary);
    font-weight: 600;
  }

  .contact-form__note.is-error {
    color: #9a4a3a;
    font-weight: 600;
  }

  .contact-form__note a {
    color: var(--color-primary);
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .contact-form__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .contact-form__field:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
</style>
