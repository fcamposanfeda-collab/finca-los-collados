---
import { inquiryOptions, isEmailFormConfigured, spanishSubjectLabel } from '../../data/forms';
import { forms } from '../../data/forms';
import { contact } from '../../data/contact';
import { localeMeta, localizePath, msg, useI18n } from '../../i18n';

interface Props {
  title?: string;
  intro?: string;
  showPhone?: boolean;
  showDates?: boolean;
  showGuests?: boolean;
  defaultSubject?: string;
  formId?: string;
}

const { locale, copy, t } = useI18n(Astro);
const formCopy = copy.forms as {
  title: string;
  intro: string;
  name: string;
  email: string;
  phone: string;
  subject: string;
  checkIn: string;
  checkOut: string;
  guests: string;
  message: string;
  submit: string;
  sending: string;
  sendError: string;
  configuredNote: string;
  mailtoFallback: string;
  defaultSubject: string;
  emailLabels: Record<string, string>;
};

const {
  title = formCopy.title,
  intro = formCopy.intro,
  showPhone = true,
  showDates = false,
  showGuests = false,
  defaultSubject = 'general',
  formId = 'contact',
} = Astro.props;

const idPrefix = formId;
const configured = isEmailFormConfigured();
const successUrl = localizePath('solicitud-enviada', locale);
const options = inquiryOptions(locale);
const languageField = localeMeta[locale].languageField;
const showAdminNote = import.meta.env.DEV && !configured;
const mailtoSubject = t('common.mailtoSubject');
const spanishEmailLabels = (msg('es').forms as { emailLabels: Record<string, string> }).emailLabels;
const mailtoFallbackHtml = formCopy.mailtoFallback
  .replace(
    '{email}',
    `<a href="mailto:${contact.email}?subject=${encodeURIComponent(mailtoSubject)}">${contact.email}</a>`,
  )
  .replace('{phone}', `<a href="tel:${contact.phone}">${contact.phoneDisplay}</a>`)
  .replace('{phoneAlt}', `<a href="tel:${contact.phoneAlt}">${contact.phoneAltDisplay}</a>`);
---

<section class="contact-form section" aria-labelledby={`${idPrefix}-form-title`}>
  <div class="container">
    {title && <h2 id={`${idPrefix}-form-title`} class="section__title">{title}</h2>}
    {intro && <p class="contact-form__intro">{intro}</p>}

    <form class="contact-form__form" data-contact-form={formId} novalidate lang={localeMeta[locale].htmlLang}>
      <input type="hidden" name="idioma" value={languageField} />
      <div class="contact-form__grid">
        <div class="contact-form__field">
          <label for={`${idPrefix}-nombre`}>{formCopy.name}</label>
          <input id={`${idPrefix}-nombre`} name="name" type="text" required autocomplete="name" />
        </div>
        <div class="contact-form__field">
          <label for={`${idPrefix}-email`}>{formCopy.email}</label>
          <input id={`${idPrefix}-email`} name="email" type="email" required autocomplete="email" />
        </div>
        {
          showPhone && (
            <div class="contact-form__field">
              <label for={`${idPrefix}-telefono`}>{formCopy.phone}</label>
              <input id={`${idPrefix}-telefono`} name="phone" type="tel" autocomplete="tel" />
            </div>
          )
        }
        <div class="contact-form__field">
          <label for={`${idPrefix}-motivo`}>{formCopy.subject}</label>
          <select id={`${idPrefix}-motivo`} name="subject" required>
            {
              options.map((item) => (
                <option value={item.value} data-package-id={item.value} selected={item.value === defaultSubject}>
                  {item.label}
                </option>
              ))
            }
          </select>
        </div>
        {
          showDates && (
            <>
              <div class="contact-form__field">
                <label for={`${idPrefix}-entrada`}>{formCopy.checkIn}</label>
                <input id={`${idPrefix}-entrada`} name="checkIn" type="date" lang={localeMeta[locale].htmlLang} />
              </div>
              <div class="contact-form__field">
                <label for={`${idPrefix}-salida`}>{formCopy.checkOut}</label>
                <input id={`${idPrefix}-salida`} name="checkOut" type="date" lang={localeMeta[locale].htmlLang} />
              </div>
            </>
          )
        }
        {
          showGuests && (
            <div class="contact-form__field">
              <label for={`${idPrefix}-invitados`}>{formCopy.guests}</label>
              <input id={`${idPrefix}-invitados`} name="guests" type="number" min="1" max="50" />
            </div>
          )
        }
      </div>

      <div class="contact-form__field">
        <label for={`${idPrefix}-mensaje`}>{formCopy.message}</label>
        <textarea id={`${idPrefix}-mensaje`} name="message" rows="5" required />
      </div>

      <button type="submit" class="btn">{formCopy.submit}</button>
      <p class="contact-form__note" data-form-status hidden></p>
      <p class="contact-form__note">
        {
          configured ? (
            <>
              {formCopy.configuredNote.split('{email}')[0]}
              <a href={`mailto:${contact.email}?subject=${encodeURIComponent(mailtoSubject)}`}>
                {contact.email}
              </a>
              {formCopy.configuredNote.split('{email}')[1] ?? ''}
            </>
          ) : showAdminNote ? (
            <>
              {t('forms.devNote').split('{email}')[0]}
              <a href={`mailto:${contact.email}?subject=${encodeURIComponent(mailtoSubject)}`}>
                {contact.email}
              </a>
              {t('forms.devNote').split('{email}')[1] ?? ''}
            </>
          ) : (
            <>
              <a href={`mailto:${contact.email}?subject=${encodeURIComponent(mailtoSubject)}`}>
                {contact.email}
              </a>
            </>
          )
        }
      </p>
    </form>
  </div>
</section>

<script define:vars={{
  formId,
  endpoint: forms.endpoint,
  accessKey: forms.web3formsAccessKey,
  recipientEmail: forms.recipientEmail,
  configured,
  successUrl,
  mailtoFallbackHtml,
  sendingLabel: formCopy.sending,
  sendError: formCopy.sendError,
  mailtoSubject,
  languageField,
  emailLabels: spanishEmailLabels,
  spanishSubjects: Object.fromEntries(
    (['general','alojamiento','finca-espacios','finca-completa','finca-fin-semana','sesiones-fotograficas','evento','empresa','pack','caza'] as const).map((id) => [id, spanishSubjectLabel(id)]),
  ),
  subjectPrefix: spanishEmailLabels.subjectPrefix,
}}>
  const form = document.querySelector(`[data-contact-form="${formId}"]`);
  const statusEl = form?.querySelector('[data-form-status]');
  const submitBtn = form?.querySelector('button[type="submit"]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const data = new FormData(form);
    const subjectId = String(data.get('subject') ?? 'general');
    const spanishSubject = spanishSubjects[subjectId] ?? subjectId;
    const payload = {
      name: String(data.get('name') ?? ''),
      email: String(data.get('email') ?? ''),
      phone: String(data.get('phone') ?? ''),
      subjectId,
      message: String(data.get('message') ?? ''),
      checkIn: String(data.get('checkIn') ?? ''),
      checkOut: String(data.get('checkOut') ?? ''),
      guests: String(data.get('guests') ?? ''),
      idioma: String(data.get('idioma') ?? languageField),
    };

    const fullMessage = [
      `${emailLabels.name}: ${payload.name}`,
      `${emailLabels.email}: ${payload.email}`,
      payload.phone ? `${emailLabels.phone}: ${payload.phone}` : '',
      payload.checkIn ? `${emailLabels.checkIn}: ${payload.checkIn}` : '',
      payload.checkOut ? `${emailLabels.checkOut}: ${payload.checkOut}` : '',
      payload.guests ? `${emailLabels.guests}: ${payload.guests}` : '',
      `${emailLabels.language}: ${payload.idioma}`,
      '',
      payload.message,
    ]
      .filter((line, index, arr) => line !== '' || arr[index - 1] === '')
      .join('\n');

    if (statusEl) {
      statusEl.hidden = false;
      statusEl.textContent = sendingLabel;
      statusEl.classList.remove('is-error', 'is-success');
    }

    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = true;
    }

    if (!configured) {
      const params = new URLSearchParams({
        subject: spanishSubject,
        body: fullMessage,
      });
      window.location.href = `mailto:${recipientEmail}?${params.toString()}`;
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = false;
      }
      if (statusEl) {
        statusEl.innerHTML = mailtoFallbackHtml;
        statusEl.classList.add('is-success');
        statusEl.classList.remove('is-error');
      }
      return;
    }

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: accessKey,
          subject: `${subjectPrefix} ${spanishSubject}`,
          name: payload.name,
          email: payload.email,
          message: fullMessage,
          idioma: payload.idioma,
        }),
      });

      const result = await response.json();
      if (!response.ok || !result.success) {
        throw new Error(result.message || 'Error');
      }

      window.location.href = successUrl;
    } catch {
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = false;
      }
      if (statusEl) {
        statusEl.innerHTML = sendError.replace(
          '{email}',
          '<a href="mailto:' +
            recipientEmail +
            '?subject=' +
            encodeURIComponent(mailtoSubject) +
            '">' +
            recipientEmail +
            '</a>',
        );
        statusEl.classList.add('is-error');
      }
    }
  });
</script>

<style>
  .contact-form__intro {
    max-width: 42rem;
    margin: 0 auto 2rem;
    text-align: center;
    color: var(--color-muted);
  }

  .contact-form__form {
    max-width: 40rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-form__grid {
    display: grid;
    gap: 1rem;
  }

  .contact-form__field label {
    display: block;
    margin-bottom: 0.375rem;
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .contact-form__field input,
  .contact-form__field textarea,
  .contact-form__field select {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .contact-form__note {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .contact-form__note.is-success {
    color: var(--color-primary);
    font-weight: 600;
  }

  .contact-form__note.is-error {
    color: #9a4a3a;
    font-weight: 600;
  }

  .contact-form__note a {
    color: var(--color-primary);
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .contact-form__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .contact-form__field:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
</style>
