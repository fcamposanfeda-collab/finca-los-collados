---
interface Props {
  locale: string;
  pageKey: string;
}

const token = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN ?? '';
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID ?? '';
const umamiEnabled = Boolean(umamiId);
const umamiScriptSrc = umamiEnabled ? 'https://cloud.umami.is/script.js' : '';
const { locale, pageKey } = Astro.props;
---

{
  token && (
    <>
      <!-- Cloudflare Web Analytics -->
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token })}
      />
      <!-- End Cloudflare Web Analytics -->
    </>
  )
}

{
  umamiEnabled && (
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id={umamiId}
      data-domains="loscolladosdesanmiguel.com,www.loscolladosdesanmiguel.com"
    />
  )
}

<script is:inline define:vars={{ locale, pageKey, umamiEnabled, umamiScriptSrc }}>
  window.__umamiQueue = window.__umamiQueue || [];

  function umamiProps(payload) {
    const props = { locale: payload.locale, page: payload.page };
    if (payload.source) props.source = payload.source;
    if (payload.motivo) props.motivo = payload.motivo;
    if (payload.modalidad) props.modalidad = payload.modalidad;
    return props;
  }

  function flushUmamiQueue() {
    try {
      if (!window.umami || typeof window.umami.track !== 'function') return false;
      const queue = window.__umamiQueue || [];
      window.__umamiQueue = [];
      for (let i = 0; i < queue.length; i++) {
        try {
          window.umami.track(queue[i][0], queue[i][1]);
        } catch (error) {}
      }
      return true;
    } catch (error) {
      return false;
    }
  }

  if (umamiEnabled) {
    try {
      document.querySelectorAll('script[src="' + umamiScriptSrc + '"]').forEach(function (el) {
        el.addEventListener('load', function () {
          flushUmamiQueue();
        });
      });
      const started = Date.now();
      const timer = setInterval(function () {
        if (flushUmamiQueue() || Date.now() - started > 10000) {
          clearInterval(timer);
        }
      }, 200);
    } catch (error) {}
  }

  window.trackConversion = function trackConversion(name, props) {
    const payload = Object.assign({ locale: locale, page: pageKey }, props || {});
    if (umamiEnabled) {
      try {
        const eventProps = umamiProps(payload);
        if (window.umami && typeof window.umami.track === 'function') {
          window.umami.track(name, eventProps);
        } else {
          window.__umamiQueue.push([name, eventProps]);
        }
      } catch (error) {}
    }
    try {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(Object.assign({ event: name }, payload));
    } catch (error) {}
  };

  document.addEventListener(
    'click',
    function (event) {
      const target = event.target instanceof Element ? event.target.closest('[data-track]') : null;
      if (!target) return;
      window.trackConversion(target.getAttribute('data-track'), {
        source: target.getAttribute('data-track-source') || 'link',
      });
    },
    true,
  );
</script>
