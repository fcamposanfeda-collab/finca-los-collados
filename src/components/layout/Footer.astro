---
import { site } from '../../data/site';
import { legalNav, footerNav } from '../../data/navigation';
import { contact } from '../../data/contact';
import { mailtoInquiryHref } from '../../data/forms';
import { useI18n } from '../../i18n';
import LanguageSwitcher from '../i18n/LanguageSwitcher.astro';

const { locale, href, t, copy } = useI18n(Astro);
const navLabels = copy.nav as Record<string, string>;
const footerCopy = copy.footer as Record<string, string>;
const common = copy.common as { copyright: string };
---

<footer class="footer" aria-label={footerCopy.aria}>
  <div class="footer__main container">
    <div class="footer__col">
      <p class="footer__title">{site.name}</p>
      <p class="footer__tagline">{t('common.tagline')}</p>
      <address class="footer__address">
        {contact.address}
      </address>
      <div class="footer__contact">
        <p class="footer__title">{footerCopy.contact}</p>
        <p>
          <a href={`tel:${contact.phone}`} data-track="phone" data-track-source="footer">{contact.phoneDisplay}</a>
        </p>
        <p>
          <a href={mailtoInquiryHref(locale)}>{contact.email}</a>
        </p>
      </div>
      <div class="footer__social-block">
        <p class="footer__title">{footerCopy.follow}</p>
        <div class="footer__social">
          <a href={contact.facebook} target="_blank" rel="noopener noreferrer" aria-label={t('common.facebook')}>
            {t('common.facebook')}
          </a>
          <a href={contact.instagram} target="_blank" rel="noopener noreferrer" aria-label={t('common.instagram')}>
            {t('common.instagram')}
          </a>
        </div>
      </div>
    </div>

    <div class="footer__col">
      <p class="footer__title">{footerCopy.explore}</p>
      <nav aria-label={footerCopy.sitemap}>
        <ul class="footer__sitemap">
          {footerNav.map((item) => (
            <li>
              <a href={href(item)}>{navLabels[item]}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

  </div>

  <div class="footer__bottom container">
    <p class="footer__copyright">{common.copyright}</p>
    <p class="footer__copyright">{t('common.tourismRegistry')}</p>
    <LanguageSwitcher />
    <nav class="footer__legal" aria-label={footerCopy.legal}>
      <ul class="footer__legal-list">
        {
          legalNav.map((item) => (
            <li>
              <a href={href(item)}>{footerCopy[
                item === 'politica-de-privacidad'
                  ? 'privacy'
                  : item === 'aviso-legal'
                    ? 'legalNotice'
                    : item === 'politica-de-cookies'
                      ? 'cookies'
                      : 'bookingPolicy'
              ]}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-footer-bg);
    color: var(--color-on-primary);
  }

  .footer__main {
    display: grid;
    gap: 2rem;
    padding-block: var(--section-padding-mobile);
  }

  .footer__title {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .footer__tagline {
    margin: 0 0 1rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .footer__address {
    font-style: normal;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
  }

  .footer__contact {
    margin-top: 1.5rem;
  }

  .footer__contact p {
    margin: 0 0 0.5rem;
  }

  .footer__social-block {
    margin-top: 1.5rem;
  }

  .footer a {
    color: rgba(255, 255, 255, 0.9);
    transition: color var(--transition-fast);
  }

  .footer a:hover {
    color: var(--color-accent);
  }

  .footer__social {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__sitemap {
    display: grid;
    gap: 0.375rem;
  }

  .footer__sitemap a {
    font-size: 0.9375rem;
  }

  @media (min-width: 1024px) {
    .footer__main {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .footer__copyright {
    margin: 0;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer__legal-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .footer__legal-list a {
    font-size: 0.875rem;
  }

  .footer :global(.language-switcher__link) {
    color: rgba(255, 255, 255, 0.9);
  }

  .footer :global(.language-switcher__link:hover),
  .footer :global(.language-switcher__link.is-active),
  .footer :global(.language-switcher__link[aria-current='page']) {
    color: var(--color-accent);
  }

  .footer :global(.language-switcher__sep) {
    color: rgba(255, 255, 255, 0.45);
  }

  @media (min-width: 768px) {
    .footer__main {
      grid-template-columns: repeat(2, 1fr);
      padding-block: var(--section-padding-desktop);
    }

    .footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
    }
  }
</style>
