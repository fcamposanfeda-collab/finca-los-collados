---
import { mainNav } from '../../data/navigation';
import { site } from '../../data/site';
import { images } from '../../data/images';
import { isActiveNav, isActiveNavItem } from '../../utils/nav';
import { useI18n } from '../../i18n';
import LanguageSwitcher from '../i18n/LanguageSwitcher.astro';

const { locale, pageKey, href, t, copy } = useI18n(Astro);
const navLabels = copy.nav as Record<string, string>;

function itemLabel(item: (typeof mainNav)[number]) {
  return navLabels[item.labelKey ?? item.pageKey] ?? item.pageKey;
}
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a href={href('home')} class="site-header__brand" aria-label={t('common.homeAria', { name: site.name })}>
      <img
        src={images.brand.header}
        alt={site.name}
        class="site-header__logo"
        width="320"
        height="72"
        decoding="async"
      />
    </a>

    <button
      type="button"
      class="site-header__toggle"
      aria-expanded="false"
      aria-controls="main-navigation"
      aria-label={t('common.menuOpen')}
      data-nav-toggle
      data-label-open={t('common.menuOpen')}
      data-label-close={t('common.menuClose')}
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="main-navigation" class="site-header__nav" aria-label={t('common.mainNavAria')} data-nav-menu>
      <ul class="site-header__list">
        {
          mainNav.map((item) =>
            item.children ? (
              <li class="site-header__item site-header__item--has-submenu">
                <div class="site-header__parent">
                  <a
                    href={href(item.pageKey)}
                    class:list={[
                      'site-header__link',
                      { 'is-active': isActiveNavItem(item, pageKey) },
                    ]}
                  >
                    {itemLabel(item)}
                  </a>
                  <button
                    type="button"
                    class="site-header__submenu-toggle"
                    aria-expanded="false"
                    aria-label={t('common.showSections', { label: itemLabel(item) })}
                    data-submenu-toggle
                  >
                    <span aria-hidden="true"></span>
                  </button>
                </div>
                <ul class="site-header__submenu">
                  {
                    item.children.map((child) => (
                      <li>
                        <a
                          href={href(child)}
                          class:list={[
                            'site-header__sublink',
                            { 'is-active': isActiveNav(child, pageKey) },
                          ]}
                        >
                          {navLabels[child]}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </li>
            ) : (
              <li>
                <a
                  href={href(item.pageKey)}
                  class:list={[
                    'site-header__link',
                    { 'is-active': isActiveNav(item.pageKey, pageKey) },
                  ]}
                >
                  {itemLabel(item)}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <a href={href('reservas-online')} class="btn site-header__cta">{t('common.bookings')}</a>
      <LanguageSwitcher />
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-nav-menu]');
  const labelOpen = toggle?.dataset.labelOpen ?? '';
  const labelClose = toggle?.dataset.labelClose ?? '';

  const syncScrolled = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 8);
  };
  syncScrolled();
  window.addEventListener('scroll', syncScrolled, { passive: true });

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? labelOpen : labelClose);
    menu?.classList.toggle('is-open', !isOpen);
    document.body.classList.toggle('nav-open', !isOpen);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', labelOpen);
      menu?.classList.remove('is-open');
      document.body.classList.remove('nav-open');
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-submenu-toggle]').forEach((btn) => {
    btn.addEventListener('click', (event) => {
      event.preventDefault();
      const item = btn.closest('.site-header__item--has-submenu');
      const isOpen = item?.classList.contains('is-submenu-open');
      document
        .querySelectorAll('.site-header__item--has-submenu.is-submenu-open')
        .forEach((openItem) => {
          if (openItem !== item) {
            openItem.classList.remove('is-submenu-open');
            openItem
              .querySelector('[data-submenu-toggle]')
              ?.setAttribute('aria-expanded', 'false');
          }
        });
      item?.classList.toggle('is-submenu-open', !isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--header-height);
    background: var(--color-header-scrolled);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 1px 0 rgb(28 25 20 / 0.06);
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  :global(body.has-hero:not(.nav-open)) .site-header:not(.is-scrolled) {
    background: transparent;
    border-bottom-color: transparent;
    box-shadow: none;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 0.75rem;
  }

  .site-header__brand {
    flex-shrink: 0;
    display: block;
    line-height: 0;
    text-decoration: none;
  }

  .site-header__logo {
    display: block;
    height: 3.25rem;
    width: auto;
    max-width: min(100%, 16rem);
    object-fit: contain;
    object-position: left center;
    transition: filter var(--transition-fast);
  }

  :global(body.has-hero:not(.nav-open)) .site-header:not(.is-scrolled) .site-header__logo {
    filter: brightness(0) invert(1);
  }

  .site-header__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: none;
    border: none;
  }

  .site-header__toggle span {
    display: block;
    width: 1.5rem;
    height: 2px;
    background: var(--color-text);
    transition:
      transform var(--transition-fast),
      background var(--transition-fast);
  }

  :global(body.has-hero:not(.nav-open)) .site-header:not(.is-scrolled) .site-header__toggle span {
    background: var(--color-on-dark);
  }

  .site-header__nav {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  .site-header__list {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.2rem 0.7rem;
    align-items: center;
  }

  .site-header__item {
    position: relative;
  }

  .site-header__parent {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .site-header__link {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-text);
    white-space: nowrap;
    transition: color var(--transition-fast), opacity var(--transition-fast);
  }

  .site-header__link:hover,
  .site-header__link.is-active {
    color: var(--color-primary);
  }

  :global(body.has-hero:not(.nav-open)) .site-header:not(.is-scrolled) .site-header__link {
    color: var(--color-on-dark);
  }

  :global(body.has-hero:not(.nav-open)) .site-header:not(.is-scrolled) .site-header__link:hover,
  :global(body.has-hero:not(.nav-open)) .site-header:not(.is-scrolled) .site-header__link.is-active {
    color: var(--color-accent);
  }

  :global(body.has-hero:not(.nav-open)) .site-header:not(.is-scrolled) :global(.language-switcher__link),
  :global(body.has-hero:not(.nav-open)) .site-header:not(.is-scrolled) :global(.language-switcher__sep) {
    color: var(--color-on-dark);
  }

  :global(body.has-hero:not(.nav-open)) .site-header:not(.is-scrolled) :global(.language-switcher__link:hover),
  :global(body.has-hero:not(.nav-open)) .site-header:not(.is-scrolled) :global(.language-switcher__link.is-active),
  :global(body.has-hero:not(.nav-open)) .site-header:not(.is-scrolled) :global(.language-switcher__link[aria-current='page']) {
    color: var(--color-accent);
  }

  :global(body.has-hero:not(.nav-open)) .site-header:not(.is-scrolled) .site-header__cta {
    background: transparent;
    color: var(--color-on-dark);
    border-color: var(--color-on-dark);
  }

  :global(body.has-hero:not(.nav-open)) .site-header:not(.is-scrolled) .site-header__cta:hover {
    background: var(--color-on-dark);
    color: var(--color-text);
  }

  :global(body.has-hero:not(.nav-open)) .site-header:not(.is-scrolled) .site-header__submenu-toggle {
    color: var(--color-on-dark);
  }

  .site-header__submenu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    background: none;
    border: none;
    color: var(--color-text);
    cursor: pointer;
  }

  .site-header__submenu-toggle span {
    display: block;
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    transition: transform var(--transition-fast);
  }

  .site-header__submenu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__sublink {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .site-header__sublink:hover,
  .site-header__sublink.is-active {
    color: var(--color-primary);
  }

  .site-header__cta {
    padding: 0.625rem 1rem;
    font-size: 0.8125rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .site-header__toggle {
      display: none;
    }

    .site-header__nav {
      display: flex;
    }

    .site-header__item--has-submenu:hover .site-header__submenu,
    .site-header__item--has-submenu:focus-within .site-header__submenu {
      display: block;
    }

    .site-header__submenu {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      min-width: 11rem;
      padding: 0.5rem 0;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
    }

    .site-header__submenu::before {
      content: '';
      position: absolute;
      top: -0.5rem;
      left: 0;
      right: 0;
      height: 0.5rem;
    }

    .site-header__sublink {
      padding: 0.5rem 1rem;
    }

    .site-header__sublink:hover {
      background: var(--color-bg-alt);
    }
  }

  @media (max-width: 1023px) {
    .site-header__nav {
      position: fixed;
      inset: var(--header-height) 0 0 0;
      flex-direction: column;
      align-items: stretch;
      padding: 2rem 1.5rem;
      background: var(--color-bg);
      border-top: 1px solid var(--color-border);
      overflow-y: auto;
    }

    .site-header__nav.is-open {
      display: flex;
    }

    .site-header__list {
      flex-direction: column;
      gap: 0;
      align-items: stretch;
    }

    .site-header__link {
      display: block;
      flex: 1;
      padding: 0.875rem 0;
      white-space: normal;
    }

    .site-header__item--has-submenu .site-header__parent {
      border-bottom: 1px solid var(--color-border);
    }

    .site-header__item:not(.site-header__item--has-submenu) .site-header__link {
      border-bottom: 1px solid var(--color-border);
    }

    .site-header__submenu-toggle {
      display: flex;
    }

    .site-header__item--has-submenu.is-submenu-open .site-header__submenu-toggle span {
      transform: rotate(-135deg) translateY(1px);
    }

    .site-header__item--has-submenu.is-submenu-open .site-header__submenu {
      display: block;
      padding: 0 0 0.75rem 1rem;
    }

    .site-header__sublink {
      padding: 0.625rem 0;
      border-bottom: 1px solid var(--color-border);
      white-space: normal;
    }

    .site-header__cta {
      margin-top: 1rem;
      width: 100%;
    }

    .site-header__nav :global(.language-switcher) {
      margin-top: 0.75rem;
      padding-top: 1rem;
      border-top: 1px solid var(--color-border);
    }
  }

  :global(body.nav-open) {
    overflow: hidden;
  }
</style>
