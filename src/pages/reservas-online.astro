---
import ContentPage from '../components/ui/ContentPage.astro';
import { getPageMeta } from '../data/pages-meta';
import { isWidgetConfigured, buildWhatsAppUrl } from '../data/booking';
import { images } from '../data/images';
import BookingSearch from '../components/booking/BookingSearch.astro';
import BookingWidget from '../components/booking/BookingWidget.astro';
import BookingAlternatives from '../components/booking/BookingAlternatives.astro';
import BookingSyncInfo from '../components/booking/BookingSyncInfo.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { useI18n } from '../i18n';

const { locale, copy } = useI18n(Astro);
const meta = getPageMeta('reservas-online', locale);
const page = copy.booking.page as {
  heroTitle: string;
  heroSubtitle: string;
  heroEyebrow: string;
};
const cta = copy.booking.cta as { title: string; text: string; button: string };
const form = copy.booking.form as { title: string; intro: string };
---

<ContentPage
  title={meta.title}
  description={meta.description}
  heroTitle={page.heroTitle}
  heroSubtitle={page.heroSubtitle}
  heroEyebrow={page.heroEyebrow}
  heroImage={images.hero.reservas}
  ctaTitle={cta.title}
  ctaText={cta.text}
  ctaButtonLabel={cta.button}
  ctaButtonHref={buildWhatsAppUrl({}, locale)}
>
  <BookingSearch />
  {isWidgetConfigured() && <BookingWidget />}
  <BookingAlternatives />
  <BookingSyncInfo />
  <ContactForm
    title={form.title}
    intro={form.intro}
    showPhone={true}
    showDates={true}
    showGuests={false}
    defaultSubject="alojamiento"
    formId="reservas"
  />
</ContentPage>
