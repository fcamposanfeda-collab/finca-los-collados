---
import ContentPage from '../components/ui/ContentPage.astro';
import TextImageMedia from '../components/ui/TextImageMedia.astro';
import { getPageMeta } from '../data/pages-meta';
import { images } from '../data/images';
import VenuePackages from '../components/venue/VenuePackages.astro';
import AzureaCatering from '../components/venue/AzureaCatering.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { useI18n } from '../i18n';

const { locale, copy } = useI18n(Astro);
const meta = getPageMeta('eventos', locale);
const page = copy.eventos as {
  hero: { eyebrow: string; title: string; subtitle: string };
  intro: string;
  capacity: { title: string; items: string[] };
  eventTypes: { title: string; lead: string; items: { title: string; description: string }[] };
  blocks: { title: string; paragraphs: string[] }[];
  venuePackages: { title: string; lead: string };
  cta: { title: string; text: string; buttonLabel: string };
  form: { title: string; intro: string };
  alts: { exterior: string };
};

const eventVenuePackageIds = [
  'finca-espacios',
  'finca-completa',
  'finca-fin-semana',
  'sesiones-fotograficas',
] as const;
---

<ContentPage
  title={meta.title}
  description={meta.description}
  heroTitle={page.hero.title}
  heroSubtitle={page.hero.subtitle}
  heroEyebrow={page.hero.eyebrow}
  heroImage={images.hero.eventos}
  ctaTitle={page.cta.title}
  ctaText={page.cta.text}
  ctaButtonLabel={page.cta.buttonLabel}
  ctaButtonHref="#solicitud-presupuesto"
>
  <section class="page-content">
    <div class="container text-image">
      <div class="page-content__inner page-content__inner--wide">
        <p class="page-content__lead">{page.intro}</p>
        <h2 class="section__title">{page.capacity.title}</h2>
        <ul class="capacity-list" style="max-width: 32rem; margin-inline: auto;">
          {page.capacity.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <TextImageMedia src={images.eventos.exterior} alt={page.alts.exterior} />
    </div>
  </section>

  <section class="page-content page-content--alt section--alt">
    <div class="container page-content__inner page-content__inner--wide">
      <h2 class="section__title">{page.eventTypes.title}</h2>
      <p class="page-content__lead">{page.eventTypes.lead}</p>
      <div class="feature-grid feature-grid--3">
        {
          page.eventTypes.items.map((item) => (
            <article class="feature-grid__card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    page.blocks.map((block) => (
      <section class="page-content">
        <div class="container page-content__inner" style="margin-inline: auto;">
          <h2>{block.title}</h2>
          {block.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </section>
    ))
  }

  <VenuePackages
    packageIds={[...eventVenuePackageIds]}
    title={page.venuePackages.title}
    lead={page.venuePackages.lead}
  />

  <AzureaCatering />

  <div id="solicitud-presupuesto">
    <ContactForm
      title={page.form.title}
      intro={page.form.intro}
      showPhone={true}
      showDates={true}
      showGuests={true}
      defaultSubject="evento"
      formId="presupuesto"
    />
  </div>
</ContentPage>
