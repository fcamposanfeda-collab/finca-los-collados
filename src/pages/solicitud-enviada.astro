---
import ContentPage from '../components/ui/ContentPage.astro';
import { getPageMeta } from '../data/pages-meta';
import { contact } from '../data/contact';
import { images } from '../data/images';
import { mailtoInquiryHref } from '../data/forms';
import { useI18n } from '../i18n';

const { locale, copy, href } = useI18n(Astro);
const meta = getPageMeta('solicitud-enviada', locale);
const page = copy['solicitud-enviada'] as {
  heroTitle: string;
  heroSubtitle: string;
  heroEyebrow: string;
  lead: string;
  note: string;
  backHome: string;
  call: string;
  alt: string;
};
const common = copy.common as { phoneDisplay: string; phoneAltDisplay: string };
const callLabel = page.call.replace('{phone}', common.phoneDisplay);
const [altBefore, altAfter] = page.alt.split('{email}');
const afterPhone = (altAfter ?? '').split('{phone}');
---

<ContentPage
  title={meta.title}
  description={meta.description}
  heroTitle={page.heroTitle}
  heroSubtitle={page.heroSubtitle}
  heroEyebrow={page.heroEyebrow}
  heroImage={images.hero.contacto}
>
  <section class="page-content solicitud-enviada">
    <div class="container solicitud-enviada__inner">
      <p class="solicitud-enviada__lead">{page.lead}</p>
      <p class="solicitud-enviada__note">{page.note}</p>

      <div class="solicitud-enviada__actions">
        <a href={href('home')} class="btn">{page.backHome}</a>
        <a href={`tel:${contact.phone}`} class="btn btn--outline">{callLabel}</a>
      </div>

      <p class="solicitud-enviada__alt">
        {altBefore}
        <a href={mailtoInquiryHref(locale)}>{contact.email}</a>
        {afterPhone[0]}
        <a href={`tel:${contact.phoneAlt}`}>{common.phoneAltDisplay}</a>
        {afterPhone[1] ?? ''}
      </p>
    </div>
  </section>
</ContentPage>

<style>
  .solicitud-enviada__inner {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  .solicitud-enviada__lead {
    margin: 0 0 1rem;
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .solicitud-enviada__note {
    margin: 0 0 2rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .solicitud-enviada__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .solicitud-enviada__alt {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .solicitud-enviada__alt a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .solicitud-enviada__alt a:hover {
    text-decoration: underline;
  }
</style>
