---
import ContentPage from '../components/ui/ContentPage.astro';
import TextImageMedia from '../components/ui/TextImageMedia.astro';
import { getPageMeta } from '../data/pages-meta';
import { images } from '../data/images';
import ContactForm from '../components/forms/ContactForm.astro';
import TrustBlock from '../components/conversion/TrustBlock.astro';
import { buildPageWhatsAppUrl } from '../data/booking';
import { contactFormUrl } from '../data/forms';
import { useI18n } from '../i18n';

const { locale, copy, t } = useI18n(Astro);
const meta = getPageMeta('la-calerilla', locale);
const page = copy['la-calerilla'] as {
  hero: { eyebrow: string; title: string; subtitle: string };
  intro: string;
  blocks: { title: string; paragraphs: string[] }[];
  featuresTitle: string;
  features: { title: string; description: string }[];
  season: { title: string; items: string[] };
  cta: { title: string; text: string; buttonLabel: string };
  form: { title: string; intro: string };
};
const blockImages = [
  images.laCalerilla.campo,
  images.laCalerilla.perdiz,
  images.laCalerilla.gastronomia,
];
---

<ContentPage
  title={meta.title}
  description={meta.description}
  heroTitle={page.hero.title}
  heroSubtitle={page.hero.subtitle}
  heroEyebrow={page.hero.eyebrow}
  heroImage={images.hero.laCalerilla}
  heroCtaLabel={t('common.whatsapp')}
  heroCtaHref={buildPageWhatsAppUrl('la-calerilla', locale)}
  heroCtaTrack="whatsapp"
  heroSecondaryLabel={page.cta.buttonLabel}
  heroSecondaryHref={contactFormUrl(locale, 'caza')}
  heroSecondaryTrack="form"
  ctaTitle={page.cta.title}
  ctaText={page.cta.text}
  ctaButtonLabel={t('common.whatsapp')}
  ctaButtonHref={buildPageWhatsAppUrl('la-calerilla', locale)}
  ctaPrimaryTrack="whatsapp"
  extraLabel={page.cta.buttonLabel}
  extraHref="#solicitud-caza"
  extraTrack="form"
>
  <section class="page-content">
    <div class="container page-content__inner page-content__inner--wide">
      <p class="page-content__lead">{page.intro}</p>
      <h2 class="section__title">{page.season.title}</h2>
      <ul class="capacity-list" style="max-width: 32rem; margin-inline: auto;">
        {page.season.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  {
    page.blocks.map((block, index) => (
      <section class:list={['page-content', { 'page-content--alt section--alt': index % 2 === 1 }]}>
        <div class:list={['container text-image', { 'text-image--media-left': index === 1 }]}>
          <div class="page-content__inner">
            <h2>{block.title}</h2>
            {block.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <TextImageMedia src={blockImages[index] ?? images.laCalerilla.campo} alt={block.title} />
        </div>
      </section>
    ))
  }

  <section class="page-content page-content--alt section--alt">
    <div class="container page-content__inner page-content__inner--wide">
      <h2 class="section__title">{page.featuresTitle}</h2>
      <div class="feature-grid feature-grid--4">
        {page.features.map((feature) => (
          <article class="feature-grid__card">
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <TrustBlock showHunting />
  <div id="solicitud-caza">
    <ContactForm
      title={page.form.title}
      intro={page.form.intro}
      showPhone={true}
      showDates={true}
      showGuests={true}
      defaultSubject="caza"
      formId="caza"
    />
  </div>
</ContentPage>
