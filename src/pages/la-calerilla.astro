---
import ContentPage from '../components/ui/ContentPage.astro';
import ImageCarousel from '../components/ui/ImageCarousel.astro';
import HuntingLoop from '../components/sections/HuntingLoop.astro';
import { getPageMeta } from '../data/pages-meta';
import { images } from '../data/images';
import { getHuntingHeroLoop } from '../data/media';
import ContactForm from '../components/forms/ContactForm.astro';
import TrustBlock from '../components/conversion/TrustBlock.astro';
import { buildPageWhatsAppUrl } from '../data/booking';
import { contactFormUrl } from '../data/forms';
import {
  hunting,
  formatHuntingDay,
  visibleLines,
} from '../data/hunting';
import { useI18n, type PageKey } from '../i18n';

const { locale, copy, t, href, meta: localeMeta } = useI18n(Astro);
const meta = getPageMeta('la-calerilla', locale);
const heroLoop = getHuntingHeroLoop();
const page = copy['la-calerilla'] as {
  hero: { eyebrow: string; title: string; subtitle: string };
  intro: string;
  experience: { title: string; steps: string[] };
  modalitiesTitle: string;
  modalities: { pageKey: PageKey; title: string; text: string }[];
  ojeoTitle: string;
  ojeoIncludesTitle: string;
  ojeoIncludes: string[];
  ojeoExtraTitle: string;
  ojeoExtra: string[];
  reserveNote: string;
  seasonTitle: string;
  seasonBody: string;
  seasonItems: string[];
  galleryTitle: string;
  cta: { title: string; text: string; buttonLabel: string };
  form: { title: string; intro: string };
  jornada: { loopName: string; loopDescription: string };
};
const seasonTitle = page.seasonTitle.replace('{season}', hunting.seasonLabel);
const seasonBody = page.seasonBody
  .replace('{start}', formatHuntingDay(hunting.general.start, localeMeta.bcp47))
  .replace('{end}', formatHuntingDay(hunting.general.end, localeMeta.bcp47));
const seasonItems = visibleLines(page.seasonItems);
const galleryAlts = [
  t('images.calerillaDesktop'),
  t('images.calerillaTemporada'),
  t('images.calerillaPerdiz'),
  t('images.calerillaMesa'),
  t('images.calerillaBungalow'),
  t('images.gallery.paisaje'),
];
const slides = images.laCalerilla.gallery.map((src, index) => ({
  src,
  alt: galleryAlts[index] ?? page.galleryTitle,
}));
---

<ContentPage
  title={meta.title}
  description={meta.description}
  heroTitle={page.hero.title}
  heroSubtitle={page.hero.subtitle}
  heroEyebrow={page.hero.eyebrow}
  heroImage={images.hero.laCalerilla}
  heroImageMobile={images.hero.laCalerillaLoop}
  heroImageAlt={t('images.calerillaDesktop')}
  heroImageAltMobile={t('images.calerillaLoop')}
  heroStillOnDesktop={true}
  heroVideoMobile={heroLoop.mobile}
  heroPauseLabel={t('conversion.pauseVideo')}
  heroPlayLabel={t('conversion.playVideo')}
  heroVideoCredit={t('conversion.videoCredit')}
  heroCtaLabel={t('common.requestDossier')}
  heroCtaHref={contactFormUrl(locale, 'caza')}
  heroCtaTrack="form"
  heroSecondaryLabel={t('common.whatsapp')}
  heroSecondaryHref={buildPageWhatsAppUrl('la-calerilla', locale)}
  heroSecondaryTrack="whatsapp"
  ctaTitle={page.cta.title}
  ctaText={page.cta.text}
  ctaButtonLabel={t('common.whatsapp')}
  ctaButtonHref={buildPageWhatsAppUrl('la-calerilla', locale)}
  ctaPrimaryTrack="whatsapp"
  extraLabel={page.cta.buttonLabel}
  extraHref="#solicitud-caza"
  extraTrack="form"
>
  {
    heroLoop.desktop && (
      <HuntingLoop
        src={heroLoop.desktop}
        poster={images.hero.laCalerillaLoop}
        title={page.jornada.loopName}
        text={page.jornada.loopDescription}
        credit={t('conversion.videoCredit')}
      />
    )
  }
  <section class="page-content">
    <div class="container page-content__inner page-content__inner--wide">
      <p class="page-content__lead">{page.intro}</p>
      <h2 class="section__title">{page.experience.title}</h2>
      <ol class="capacity-list">
        {page.experience.steps.map((step) => <li>{step}</li>)}
      </ol>
      <h2 class="section__title">{page.modalitiesTitle}</h2>
      <div class="feature-grid feature-grid--4">
        {
          page.modalities.map((item) =>
            item.pageKey === 'la-calerilla' ? (
              <article class="feature-grid__card">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ) : (
              <article class="feature-grid__card">
                <h3>
                  <a href={href(item.pageKey)}>{item.title}</a>
                </h3>
                <p>{item.text}</p>
              </article>
            ),
          )
        }
      </div>
    </div>
  </section>

  <section class="page-content page-content--alt section--alt">
    <div class="container page-content__inner">
      <h2 class="section__title">{page.ojeoTitle}</h2>
      <h3>{page.ojeoIncludesTitle}</h3>
      <ul class="capacity-list">
        {page.ojeoIncludes.map((item) => <li>{item}</li>)}
      </ul>
      <h3>{page.ojeoExtraTitle}</h3>
      <ul class="capacity-list">
        {page.ojeoExtra.map((item) => <li>{item}</li>)}
      </ul>
      <p>{page.reserveNote}</p>
      <p>
        <a href={href('caza-ojeo-perdiz')} class="btn">{t('common.seeMore')}</a>
      </p>
    </div>
  </section>

  <section class="page-content">
    <div class="container page-content__inner">
      <h2 class="section__title">{seasonTitle}</h2>
      <p>{seasonBody}</p>
      <ul class="capacity-list">
        {seasonItems.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="page-content page-content--alt section--alt">
    <div class="container">
      <h2 class="section__title">{page.galleryTitle}</h2>
      <ImageCarousel slides={slides} id="calerilla-gallery" variant="gallery" />
    </div>
  </section>

  <TrustBlock variant="hunting" />
  <div id="solicitud-caza">
    <ContactForm
      title={page.form.title}
      intro={page.form.intro}
      showPhone={true}
      showDates={true}
      showGuests={true}
      defaultSubject="caza"
      formId="caza"
    />
  </div>
</ContentPage>
