---
import ContentPage from '../components/ui/ContentPage.astro';
import TextImageMedia from '../components/ui/TextImageMedia.astro';
import ImageCarousel from '../components/ui/ImageCarousel.astro';
import FullWidthVideo from '../components/ui/FullWidthVideo.astro';
import { getPageMeta } from '../data/pages-meta';
import { images } from '../data/images';
import { getLaFincaHeroLoop } from '../data/media';
import { useI18n } from '../i18n';

const { locale, copy, href, t } = useI18n(Astro);
const heroLoop = getLaFincaHeroLoop();
const meta = getPageMeta('la-finca', locale);
const page = copy['la-finca'] as {
  hero: { eyebrow: string; title: string; subtitle: string };
  blocks: { title: string; paragraphs: string[] }[];
  features: { title: string; description: string }[];
  cta: { title: string; text: string };
  calerilla: { title: string; paragraphs: string[]; button: string };
  highlightsTitle: string;
  alts: { culturas: string; calerilla: string; closing: string };
};
const galleryAlts = (copy.images as { gallery: Record<string, string> }).gallery;
const galleryKeys = ['jardines', 'porche', 'salon', 'entrada', 'paisaje', 'edificaciones', 'olivar'] as const;
const slides = images.laFinca.gallery.map((src, index) => ({
  src,
  alt: galleryAlts[galleryKeys[index]] ?? '',
}));
---

<ContentPage
  title={meta.title}
  description={meta.description}
  heroTitle={page.hero.title}
  heroSubtitle={page.hero.subtitle}
  heroEyebrow={page.hero.eyebrow}
  heroImage={images.hero.laFinca}
  heroImageAlt={t('images.heroLaFinca')}
  heroVideoDesktop={heroLoop.desktop}
  heroVideoMobile={heroLoop.mobile}
  heroVideoLoop={false}
  heroPauseLabel={t('conversion.pauseVideo')}
  heroPlayLabel={t('conversion.playVideo')}
  ctaTitle={page.cta.title}
  ctaText={page.cta.text}
>
  {
    page.blocks.map((block, index) => (
      <section class:list={['page-content', { 'page-content--alt section--alt': index % 2 === 1 }]}>
        <div class:list={['container text-image', { 'text-image--media-left': index === 1 }]}>
          <div class="page-content__inner">
            <h2>{block.title}</h2>
            {block.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          {
            index === 1 ? (
              <div class="text-image__media">
                <ImageCarousel slides={slides} id="la-finca-espacios" />
              </div>
            ) : (
              <TextImageMedia
                video={images.videos.laFincaCulturas}
                alt={block.title}
                poster={images.laFinca.culturas}
                startTime={5}
              />
            )
          }
        </div>
      </section>
    ))
  }

  <section class="page-content page-content--alt section--alt">
    <div class="container text-image">
      <div class="page-content__inner">
        <h2>{page.calerilla.title}</h2>
        {page.calerilla.paragraphs.map((p) => <p>{p}</p>)}
        <a href={href('la-calerilla')} class="btn">{page.calerilla.button}</a>
      </div>
      <TextImageMedia src={images.laCalerilla.campo} alt={page.alts.calerilla} />
    </div>
  </section>

  <FullWidthVideo
    src={images.videos.fincaShowcase}
    alt={page.alts.closing}
    objectPosition="center 42%"
  />

  <section class="page-content">
    <div class="container page-content__inner page-content__inner--wide">
      <h2 class="section__title">{page.highlightsTitle}</h2>
      <div class="feature-grid feature-grid--4">
        {page.features.map((feature) => (
          <article class="feature-grid__card">
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</ContentPage>
