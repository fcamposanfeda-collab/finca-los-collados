---
import ContentPage from '../components/ui/ContentPage.astro';
import ContentImage from '../components/ui/ContentImage.astro';
import { getPageMeta } from '../data/pages-meta';
import { images } from '../data/images';
import { bookingComPropertyUrl, buildPageWhatsAppUrl } from '../data/booking';
import { useI18n } from '../i18n';

const { locale, copy, t, href } = useI18n(Astro);
const meta = getPageMeta('packs', locale);
const page = copy.packs as {
  hero: { eyebrow: string; title: string; subtitle: string };
  intro: string;
  items: { slug: keyof typeof images.packs; title: string; description: string; highlights: string[] }[];
  cta: { title: string; text: string };
};
---

<ContentPage
  title={meta.title}
  description={meta.description}
  heroTitle={page.hero.title}
  heroSubtitle={page.hero.subtitle}
  heroEyebrow={page.hero.eyebrow}
  heroImage={images.hero.packs}
  heroCtaLabel={(copy.booking as { bookingComLabel: string }).bookingComLabel}
  heroCtaHref={bookingComPropertyUrl(locale)}
  heroCtaTrack="booking"
  heroSecondaryLabel={t('common.whatsapp')}
  heroSecondaryHref={buildPageWhatsAppUrl('packs', locale)}
  heroSecondaryTrack="whatsapp"
  ctaTitle={page.cta.title}
  ctaText={page.cta.text}
  ctaButtonLabel={(copy.booking as { bookingComLabel: string }).bookingComLabel}
  ctaButtonHref={bookingComPropertyUrl(locale)}
  ctaPrimaryTrack="booking"
  extraLabel={t('common.whatsapp')}
  extraHref={buildPageWhatsAppUrl('packs', locale)}
  extraTrack="whatsapp"
>
  <section class="page-content">
    <div class="container page-content__inner page-content__inner--wide">
      <p class="page-content__lead">{page.intro}</p>
      <div class="packs-grid">
        {
          page.items.map((pack) => (
            <article class="packs-grid__card packs-grid__card--media">
              <div class="card-media">
                <ContentImage src={images.packs[pack.slug] ?? images.hero.packs} alt={pack.title} />
              </div>
              <div class="card-body">
                <h3>
                  {pack.slug === 'caza' ? <a href={href('la-calerilla')}>{pack.title}</a> : pack.title}
                </h3>
                <p>{pack.description}</p>
                <ul class="packs-grid__highlights">
                  {pack.highlights.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</ContentPage>
