---
import ContentPage from '../components/ui/ContentPage.astro';
import ContentImage from '../components/ui/ContentImage.astro';
import { getPageMeta } from '../data/pages-meta';
import ContactForm from '../components/forms/ContactForm.astro';
import { contact } from '../data/contact';
import { images } from '../data/images';
import { mailtoInquiryHref } from '../data/forms';
import { inquirySubjectIds } from '../data/forms';
import { site } from '../data/site';
import { useI18n } from '../i18n';

const { locale, copy, t } = useI18n(Astro);
const meta = getPageMeta('contacto', locale);
const page = copy.contacto as {
  hero: { eyebrow: string; title: string; subtitle: string };
  form: { title: string; intro: string };
  alts: { porche: string };
};

const motivo = Astro.url.searchParams.get('motivo') ?? 'general';
const defaultSubject = inquirySubjectIds.includes(motivo as (typeof inquirySubjectIds)[number])
  ? motivo
  : 'general';
---

<ContentPage
  title={meta.title}
  description={meta.description}
  heroTitle={page.hero.title}
  heroSubtitle={page.hero.subtitle}
  heroEyebrow={page.hero.eyebrow}
  heroImage={images.hero.contacto}
>
  <section class="page-content">
    <div class="container text-image">
      <div class="contacto-info">
        <div class="contacto-info__grid">
          <div>
            <h2>{site.name}</h2>
            <address>
              {contact.address}
            </address>
            <p>
              <a href={`tel:${contact.phone}`} data-track="phone" data-track-source="contacto">{contact.phoneDisplay}</a>
            </p>
            <p><a href={mailtoInquiryHref(locale)}>{contact.email}</a></p>
            <p>
              <a href={contact.mapsUrl} target="_blank" rel="noopener noreferrer">{t('common.maps')}</a>
            </p>
          </div>
        </div>
      </div>
      <ContentImage src={images.hero.contacto} alt={page.alts.porche} />
    </div>
  </section>

  <ContactForm
    title={page.form.title}
    intro={page.form.intro}
    showPhone={true}
    showDates={true}
    showGuests={true}
    defaultSubject={defaultSubject}
    formId="presupuesto"
  />
</ContentPage>

<style>
  .contacto-info h2 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    color: var(--color-secondary);
  }

  .contacto-info address {
    margin-bottom: 1rem;
    font-style: normal;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .contacto-info a {
    color: var(--color-primary);
    font-weight: 500;
  }
</style>
