---
import ContentPage from '../components/ui/ContentPage.astro';
import ContentImage from '../components/ui/ContentImage.astro';
import FullWidthVideo from '../components/ui/FullWidthVideo.astro';
import GastronomiaMoments from '../components/sections/GastronomiaMoments.astro';
import { getPageMeta } from '../data/pages-meta';
import { images } from '../data/images';
import { useI18n } from '../i18n';

const { locale, copy, href } = useI18n(Astro);
const meta = getPageMeta('gastronomia', locale);
const page = copy.gastronomia as {
  hero: { eyebrow: string; title: string; subtitle: string };
  lead: string;
  subtitle: string;
  description: string;
  dishes: string;
  quote: string;
  huntingLink: { text: string; label: string };
  features: { title: string; description: string }[];
  moments: { videoAlt: string };
  cta: { title: string; text: string };
  alts: { banner: string };
};
---

<ContentPage
  title={meta.title}
  description={meta.description}
  heroTitle={page.hero.title}
  heroSubtitle={page.hero.subtitle}
  heroEyebrow={page.hero.eyebrow}
  heroImage={images.hero.gastronomia}
  ctaTitle={page.cta.title}
  ctaText={page.cta.text}
>
  <section class="page-content">
    <div class="container page-content__inner" style="margin-inline: auto; text-align: center;">
      <div class="page-banner-image">
        <ContentImage src={images.experiencias.gastronomia} alt={page.alts.banner} aspect="natural" />
      </div>
      <p class="page-content__lead">{page.lead}</p>
      <p>
        {page.huntingLink.text}{' '}
        <a href={href('la-calerilla')}>{page.huntingLink.label}</a>
      </p>
      <p class="gastronomia-subtitle">{page.subtitle}</p>
      <p>{page.description}</p>
      <p style="font-weight: 500; color: var(--color-text);">{page.dishes}</p>
      <blockquote class="gastronomia-quote">{page.quote}</blockquote>
    </div>
  </section>

  <GastronomiaMoments />

  <section class="page-content page-content--alt section--alt">
    <div class="container page-content__inner page-content__inner--wide">
      <div class="feature-grid">
        {page.features.map((feature) => (
          <article class="feature-grid__card">
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="gastronomia-video">
    <FullWidthVideo
      src={images.videos.gastronomiaMomentos}
      alt={page.moments.videoAlt}
      objectPosition="center 52%"
      playbackRate={0.45}
    />
  </div>
</ContentPage>

<style>
  .gastronomia-subtitle {
    font-style: italic;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }

  .gastronomia-video :global(video) {
    height: clamp(12rem, 32vw, 24rem);
  }
</style>
