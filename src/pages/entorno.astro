---
import ContentPage from '../components/ui/ContentPage.astro';
import ContentImage from '../components/ui/ContentImage.astro';
import { getPageMeta } from '../data/pages-meta';
import { images } from '../data/images';
import { useI18n } from '../i18n';

const { locale, copy, href } = useI18n(Astro);
const meta = getPageMeta('entorno', locale);
const page = copy.entorno as {
  hero: { eyebrow: string; title: string; subtitle: string };
  intro: string;
  huntingLink: { text: string; label: string };
  distancesTitle: string;
  distancesNote: string;
  distances: { place: string; detail: string }[];
  places: { id: keyof typeof images.entorno; title: string; description: string }[];
  cta: { title: string; text: string };
};
---

<ContentPage
  title={meta.title}
  description={meta.description}
  heroTitle={page.hero.title}
  heroSubtitle={page.hero.subtitle}
  heroEyebrow={page.hero.eyebrow}
  heroImage={images.hero.entorno}
  ctaTitle={page.cta.title}
  ctaText={page.cta.text}
>
  <section class="page-content">
    <div class="container page-content__inner page-content__inner--wide">
      <p class="page-content__lead">{page.intro}</p>
      <p>
        {page.huntingLink.text}{' '}
        <a href={href('caza-como-llegar')}>{page.huntingLink.label}</a>
      </p>
      <h2 class="section__title">{page.distancesTitle}</h2>
      <p class="page-content__lead">{page.distancesNote}</p>
      <table class="distances-table">
        <tbody>
          {page.distances.map((row) => (
            <tr>
              <th scope="row">{row.place}</th>
              <td>{row.detail}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="feature-grid">
        {
          page.places.map((place) => (
            <article class="feature-grid__card feature-grid__card--media">
              <div class="card-media">
                <ContentImage src={images.entorno[place.id] ?? images.hero.entorno} alt={place.title} />
              </div>
              <div class="card-body">
                <h3>{place.title}</h3>
                <p>{place.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</ContentPage>
