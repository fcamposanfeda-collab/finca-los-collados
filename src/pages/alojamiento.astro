---
import ContentPage from '../components/ui/ContentPage.astro';
import TextImageMedia from '../components/ui/TextImageMedia.astro';
import TrustBlock from '../components/conversion/TrustBlock.astro';
import { getPageMeta } from '../data/pages-meta';
import { images } from '../data/images';
import { bookingComPropertyUrl, buildPageWhatsAppUrl } from '../data/booking';
import { useI18n } from '../i18n';

const { locale, copy, t } = useI18n(Astro);
const meta = getPageMeta('alojamiento', locale);
const page = copy.alojamiento as {
  hero: { eyebrow: string; title: string; subtitle: string };
  intro: string;
  capacity: { title: string; items: string[] };
  amenitiesTitle: string;
  amenities: string[];
  cta: { title: string; text: string };
  alts: { interior: string; amenities: string; closing: string };
};
const mid = Math.ceil(page.amenities.length / 2);
const col1 = page.amenities.slice(0, mid);
const col2 = page.amenities.slice(mid);
---

<ContentPage
  title={meta.title}
  description={meta.description}
  heroTitle={page.hero.title}
  heroSubtitle={page.hero.subtitle}
  heroEyebrow={page.hero.eyebrow}
  heroImage={images.hero.alojamiento}
  heroImageAlt={page.alts.interior}
  heroCtaLabel={(copy.booking as { bookingComLabel: string }).bookingComLabel}
  heroCtaHref={bookingComPropertyUrl(locale)}
  heroCtaTrack="booking"
  heroSecondaryLabel={t('common.whatsapp')}
  heroSecondaryHref={buildPageWhatsAppUrl('alojamiento', locale)}
  heroSecondaryTrack="whatsapp"
  ctaTitle={page.cta.title}
  ctaText={page.cta.text}
  ctaButtonLabel={(copy.booking as { bookingComLabel: string }).bookingComLabel}
  ctaButtonHref={bookingComPropertyUrl(locale)}
  ctaPrimaryTrack="booking"
  extraLabel={t('common.whatsapp')}
  extraHref={buildPageWhatsAppUrl('alojamiento', locale)}
  extraTrack="whatsapp"
  closingVideo={images.videos.bungalowClosing}
  closingVideoAlt={page.alts.closing}
  closingVideoPosition="center 58%"
>
  <section class="page-content">
    <div class="container text-image">
      <div class="page-content__inner">
        <p class="page-content__lead">{page.intro}</p>
        <h2>{page.capacity.title}</h2>
        <ul class="capacity-list">
          {page.capacity.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <TextImageMedia video={images.videos.bungalowInterior} alt={page.alts.interior} />
    </div>
  </section>

  <section class="page-content page-content--alt section--alt">
    <div class="container text-image text-image--media-left text-image--fill">
      <div class="page-content__inner">
        <h2>{page.amenitiesTitle}</h2>
        <div class="amenities-list">
          <ul>{col1.map((item) => <li>{item}</li>)}</ul>
          <ul>{col2.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
      <TextImageMedia
        video={images.videos.bungalowAmenities}
        alt={page.alts.amenities}
      />
    </div>
  </section>
  <TrustBlock />
</ContentPage>
